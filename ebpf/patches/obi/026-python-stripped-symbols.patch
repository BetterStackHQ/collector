+// addDerivedSymbols fills in the exact-match symbols the symbol tables did not
+// provide, for the CPython libraries whose stripped builds pyelf can read. A
+// derived address that an already resolved symbol owns (an LTO-renamed
+// duplicate such as context_run.lto_priv.0) is dropped, so a program is never
+// attached twice to one function.
+func addDerivedSymbols(
+	elfFile *elf.File,
+	instrPath string,
+	probes map[string][]*ebpfcommon.ProbeDesc,
+	exactSyms map[string]procs.Sym,
+	log *slog.Logger,
+) {
+	var missing []string
+	for _, name := range symbolNames(probes, ebpfcommon.SymbolMatcherExact) {
+		if _, ok := exactSyms[name]; !ok {
+			missing = append(missing, name)
+		}
+	}
+	if len(missing) == 0 {
+		return
+	}
+	mergeDerivedSymbols(exactSyms, pyelf.Synthesize(elfFile, instrPath, missing, log), log)
+}
+
+func mergeDerivedSymbols(exactSyms, derived map[string]procs.Sym, log *slog.Logger) {
+	taken := make(map[uint64]string, len(exactSyms))
+	for name, sym := range exactSyms {
+		taken[sym.Off] = name
+	}
+	// Two derived names at one address mean the derivation went wrong
+	// somewhere; neither is trusted.
+	derivedAt := make(map[uint64]int, len(derived))
+	for _, sym := range derived {
+		derivedAt[sym.Off]++
+	}
+	for name, sym := range derived {
+		if derivedAt[sym.Off] > 1 {
+			log.Debug("derived symbols collide at one address, skipping", "symbol", name, "offset", sym.Off)
+			continue
+		}
+		if other, dup := taken[sym.Off]; dup {
+			log.Debug("derived symbol shares its address with a resolved one, skipping", "symbol", name, "resolved", other)
+			continue
+		}
+		exactSyms[name] = sym
+	}
+}
