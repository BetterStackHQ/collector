diff --git a/pkg/internal/pyelf/types.go b/pkg/internal/pyelf/types.go
new file mode 100644
index 000000000..ea206e643
--- /dev/null
+++ b/pkg/internal/pyelf/types.go
@@ -0,0 +1,226 @@
+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package pyelf // import "go.opentelemetry.io/obi/pkg/internal/pyelf"
+
+import (
+	"fmt"
+	"slices"
+)
+
+// Field offsets of CPython's C structures on 64-bit builds with the GIL. They
+// have been stable from 3.9 through 3.14; the free-threaded builds, whose
+// object header is wider, are rejected before any of these are used.
+const (
+	// PyTypeObject
+	tpName      = 24
+	tpBasicSize = 32
+	tpItemSize  = 40
+	tpDealloc   = 48
+	tpCall      = 128
+	tpFlags     = 168
+	tpMethods   = 232
+	tpInit      = 296
+
+	// PyMethodDef: {ml_name, ml_meth, ml_flags, ml_doc}
+	mlName     = 0
+	mlMeth     = 8
+	mlFlags    = 16
+	methodSize = 32
+
+	methKeywords = 0x0002
+	methO        = 0x0008
+	methFastcall = 0x0080
+
+	// PyType_Spec: {name, basicsize, itemsize, flags, slots}
+	specName      = 0
+	specBasicSize = 8
+	specItemSize  = 12
+	specFlags     = 16
+	specSlots     = 24
+
+	// PyType_Slot: {slot, pfunc}
+	slotID   = 0
+	slotFunc = 8
+	slotSize = 16
+	pyTpCall = 50
+	pyTpInit = 60
+
+	maxMethods = 256
+	maxSlots   = 64
+)
+
+// pyType is a CPython type found in the data of a module: either a static
+// PyTypeObject (libpython, _asyncio before 3.12) or the PyType_Spec a heap
+// type is created from (_asyncio since 3.12).
+type pyType struct {
+	img  *image
+	name string
+	addr uint64
+	spec bool
+}
+
+// typeObject validates a static PyTypeObject at addr whose tp_name must be one
+// of the given names.
+func (img *image) typeObject(addr uint64, names ...string) (*pyType, error) {
+	got, ok := img.stringAt(addr + tpName)
+	if !ok || !slices.Contains(names, got) {
+		return nil, fmt.Errorf("type at 0x%x is not %q", addr, names)
+	}
+	name := got
+	basic, ok := img.word(addr + tpBasicSize)
+	if !ok || basic < minBasicSize || basic > maxBasicSize {
+		return nil, fmt.Errorf("type %s has an implausible tp_basicsize", name)
+	}
+	if item, ok := img.word(addr + tpItemSize); !ok || item != 0 {
+		return nil, fmt.Errorf("type %s has a nonzero tp_itemsize", name)
+	}
+	if flags, ok := img.word(addr + tpFlags); !ok || flags == 0 || flags>>32 != 0 {
+		return nil, fmt.Errorf("type %s has implausible tp_flags", name)
+	}
+	if dealloc, ok := img.pointer(addr + tpDealloc); !ok || !img.inText(dealloc) {
+		return nil, fmt.Errorf("type %s has no tp_dealloc", name)
+	}
+	return &pyType{img: img, name: name, addr: addr}, nil
+}
+
+// typeSpec validates a PyType_Spec at addr whose name must match.
+func (img *image) typeSpec(addr uint64, name string) (*pyType, error) {
+	got, ok := img.stringAt(addr + specName)
+	if !ok || got != name {
+		return nil, fmt.Errorf("spec at 0x%x is not %q", addr, name)
+	}
+	basic, ok := img.word32(addr + specBasicSize)
+	if !ok || basic < minBasicSize || basic > maxBasicSize {
+		return nil, fmt.Errorf("spec %s has an implausible basicsize", name)
+	}
+	if item, ok := img.word32(addr + specItemSize); !ok || item != 0 {
+		return nil, fmt.Errorf("spec %s has a nonzero itemsize", name)
+	}
+	if flags, ok := img.word32(addr + specFlags); !ok || flags == 0 {
+		return nil, fmt.Errorf("spec %s has no flags", name)
+	}
+	if _, ok := img.pointer(addr + specSlots); !ok {
+		return nil, fmt.Errorf("spec %s has no slots", name)
+	}
+	return &pyType{img: img, name: name, addr: addr, spec: true}, nil
+}
+
+// findType locates a type by its tp_name, trying the static layout and the
+// spec layout. Exactly one data slot must point at the name string.
+func (img *image) findType(names ...string) (*pyType, error) {
+	var errs []error
+	for _, name := range names {
+		str, err := img.findCString(name)
+		if err != nil {
+			errs = append(errs, err)
+			continue
+		}
+		slots := img.slotsPointingAt(str)
+		if len(slots) != 1 {
+			errs = append(errs, fmt.Errorf("%d data pointers to %q, expected 1", len(slots), name))
+			continue
+		}
+		slot := slots[0]
+		if t, err := img.typeSpec(slot-specName, name); err == nil {
+			return t, nil
+		}
+		if t, err := img.typeObject(slot-tpName, name); err == nil {
+			return t, nil
+		}
+		errs = append(errs, fmt.Errorf("the pointer to %q is neither a type object nor a type spec", name))
+	}
+	return nil, fmt.Errorf("type not found: %v", errs)
+}
+
+// slotFunc returns the function stored in a slot: the given PyTypeObject field
+// offset for static types, or the Py_tp_* slot id for specs.
+func (t *pyType) slotFunc(fieldOffset uint64, slotIDs ...int32) (uint64, error) {
+	if !t.spec {
+		p, ok := t.img.pointer(t.addr + fieldOffset)
+		if !ok {
+			return 0, fmt.Errorf("type %s has no function at field offset %d", t.name, fieldOffset)
+		}
+		return p, nil
+	}
+	table, _ := t.img.pointer(t.addr + specSlots)
+	for i := uint64(0); i < maxSlots; i++ {
+		entry := table + i*slotSize
+		id, ok := t.img.word32(entry + slotID)
+		if !ok {
+			return 0, fmt.Errorf("spec %s: unreadable slot table", t.name)
+		}
+		if id == 0 {
+			break
+		}
+		for _, want := range slotIDs {
+			if int32(id) == want {
+				p, ok := t.img.pointer(entry + slotFunc)
+				if !ok {
+					return 0, fmt.Errorf("spec %s: slot %d has no function", t.name, id)
+				}
+				return p, nil
+			}
+		}
+	}
+	return 0, fmt.Errorf("spec %s has none of the slots %v", t.name, slotIDs)
+}
+
+func (t *pyType) initFunc() (uint64, error) { return t.slotFunc(tpInit, pyTpInit) }
+
+func (t *pyType) callFunc() (uint64, error) { return t.slotFunc(tpCall, pyTpCall) }
+
+// method walks the type's PyMethodDef table (static types only) for an entry
+// with the given name and exact flags.
+func (t *pyType) method(name string, flags uint32) (uint64, error) {
+	if t.spec {
+		return 0, fmt.Errorf("spec %s: method tables are only walked on static types", t.name)
+	}
+	table, ok := t.img.pointer(t.addr + tpMethods)
+	if !ok {
+		return 0, fmt.Errorf("type %s has no tp_methods", t.name)
+	}
+	for i := uint64(0); i < maxMethods; i++ {
+		entry := table + i*methodSize
+		mname, ok := t.img.stringAt(entry + mlName)
+		if !ok {
+			break // ml_name == NULL ends the table
+		}
+		if mname != name {
+			continue
+		}
+		mflags, ok := t.img.word32(entry + mlFlags)
+		if !ok || mflags != flags {
+			return 0, fmt.Errorf("method %s.%s has flags 0x%x, expected 0x%x", t.name, name, mflags, flags)
+		}
+		fn, ok := t.img.pointer(entry + mlMeth)
+		if !ok {
+			return 0, fmt.Errorf("method %s.%s has no function", t.name, name)
+		}
+		return fn, nil
+	}
+	return 0, fmt.Errorf("type %s has no method %s", t.name, name)
+}
+
+// methodDef finds a standalone PyMethodDef by name and exact flags; exactly one
+// data pointer must reference the name string.
+func (img *image) methodDef(name string, flags uint32) (uint64, error) {
+	str, err := img.findCString(name)
+	if err != nil {
+		return 0, err
+	}
+	slots := img.slotsPointingAt(str)
+	if len(slots) != 1 {
+		return 0, fmt.Errorf("%d data pointers to %q, expected 1", len(slots), name)
+	}
+	entry := slots[0] - mlName
+	mflags, ok := img.word32(entry + mlFlags)
+	if !ok || mflags != flags {
+		return 0, fmt.Errorf("method def %s has flags 0x%x, expected 0x%x", name, mflags, flags)
+	}
+	fn, ok := img.pointer(entry + mlMeth)
+	if !ok {
+		return 0, fmt.Errorf("method def %s has no function", name)
+	}
+	return fn, nil
+}
