+// ownCgroupExclusion resolves the cgroup discovery.exclude_own_cgroup keeps
+// out of instrumentation, or nil when there is none to exclude: the option is
+// off, or this process runs in the root cgroup, or its cgroup cannot be read.
+func ownCgroupExclusion(cfg *obi.Config, log *slog.Logger) cgroupMembership {
+	if !cfg.Discovery.ExcludeOwnCgroup {
+		return nil
+	}
+	own, err := ownCgroupFunc()
+	if err != nil {
+		switch {
+		case errors.Is(err, procs.ErrRootCgroup):
+			log.Info("not excluding the instrumentation's own cgroup: it is the root cgroup, shared by every process on this host")
+		case errors.Is(err, procs.ErrHybridCgroup):
+			log.Info("not excluding the instrumentation's own cgroup: on this host the unified cgroup hierarchy does not tell containers apart", "error", err)
+		default:
+			log.Warn("cannot identify the instrumentation's own cgroup; its processes stay eligible for instrumentation", "error", err)
+		}
+		return nil
+	}
+	log.Info("excluding the instrumentation's own cgroup from instrumentation", "cgroup", own.String())
+	return own
+}
