diff --git a/bpf/generictracer/own_cgroup.h b/bpf/generictracer/own_cgroup.h
new file mode 100644
index 000000000..4927db063
--- /dev/null
+++ b/bpf/generictracer/own_cgroup.h
@@ -0,0 +1,98 @@
+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <bpfcore/vmlinux.h>
+#include <bpfcore/bpf_core_read.h>
+#include <bpfcore/bpf_helpers.h>
+
+#include <common/connection_info.h>
+#include <common/sockaddr.h>
+
+#include <generictracer/maps/own_cgroup_conns.h>
+
+// Keeping the instrumentation's own container out of the traces.
+//
+// Discovery never instruments a process that shares this cgroup (see
+// discovery.exclude_own_cgroup), which takes care of the client side. The
+// servers those processes talk to are instrumented, though, and a metric
+// scrape, a health probe or an inspector session the instrumentation itself
+// opens would still be reported as the server's own traffic: a root span with
+// no application behind it. So a connect from this cgroup is remembered here,
+// and the server side refuses to parse the connection.
+//
+// The id is the cgroup v2 node this process runs in, resolved in userspace
+// (procs.OwnCgroup). Zero turns everything below off: the option is disabled,
+// or the process runs in the root cgroup, which every task on the host
+// shares and so identifies nothing.
+volatile const u64 own_cgroup_id = 0;
+
+static __always_inline bool in_own_cgroup(void) {
+    return own_cgroup_id != 0 && bpf_get_current_cgroup_id() == own_cgroup_id;
+}
+
+// The key is the sorted tuple with the server address blanked. Destination
+// NAT on a published container port or a service IP rewrites that address
+// between the client's connect and the server's accept, while the client's
+// address and port and the server port survive it. The sort only looks at the
+// ports, so both ends spell the key the same way whatever happened to the
+// addresses. What can still defeat the lookup fails open: a port-remapping
+// NAT, source NAT, a userland proxy terminating the connection, or a server
+// on another host, none of which leave the client's tuple intact. A collision
+// with an unrelated connection needs the same client address and port towards
+// the same server port on a different server, at the same time.
+static __always_inline void own_cgroup_conn_key(const connection_info_t *conn,
+                                                connection_info_t *key) {
+    *key = *conn;
+    sort_connection_info(key);
+    __builtin_memset(key->d_addr, 0, sizeof(key->d_addr));
+}
+
+static __always_inline void own_cgroup_conn_record(const connection_info_t *conn) {
+    connection_info_t key;
+    own_cgroup_conn_key(conn, &key);
+    bpf_map_update_elem(&own_cgroup_conns, &key, &(u8){1}, BPF_ANY);
+}
+
+static __always_inline void own_cgroup_conn_forget(const connection_info_t *conn) {
+    if (own_cgroup_id == 0) {
+        return;
+    }
+    connection_info_t key;
+    own_cgroup_conn_key(conn, &key);
+    bpf_map_delete_elem(&own_cgroup_conns, &key);
+}
+
+static __always_inline bool is_own_cgroup_conn(const connection_info_t *conn) {
+    if (own_cgroup_id == 0) {
+        return false;
+    }
+    connection_info_t key;
+    own_cgroup_conn_key(conn, &key);
+    return bpf_map_lookup_elem(&own_cgroup_conns, &key) != NULL;
+}
+
+// Remembers an established socket that belongs to this cgroup: the connect
+// kprobe never saw the connections the cgroup already held when the tracer
+// loaded. The socket keeps the cgroup v2 node of the task that created it
+// (cgroup_sk_alloc). On a kernel whose sock_cgroup_data still packs that
+// pointer into a word, before the explicit layout of 5.15, the field is
+// absent and the connection stays visible. The caller skips accepted
+// sockets: those inherit their listener's cgroup, not their peer's.
+static __always_inline void own_cgroup_record_established(struct sock *sk) {
+    if (own_cgroup_id == 0) {
+        return;
+    }
+    if (!bpf_core_field_exists(((struct sock *)0)->sk_cgrp_data.cgroup)) {
+        return;
+    }
+    const u64 cgroup_id = BPF_CORE_READ(sk, sk_cgrp_data.cgroup, kn, id);
+    if (cgroup_id != own_cgroup_id) {
+        return;
+    }
+    connection_info_t conn;
+    if (parse_sock_info(sk, &conn)) {
+        own_cgroup_conn_record(&conn);
+    }
+}
