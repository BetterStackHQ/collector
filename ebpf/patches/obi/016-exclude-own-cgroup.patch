+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+//go:build !linux
+
+package procs // import "go.opentelemetry.io/obi/pkg/internal/procs"
+
+import (
+	"errors"
+
+	"go.opentelemetry.io/obi/pkg/appolly/app"
+)
+
+// Cgroup is the cgroup v2 node this process runs in. Only Linux has them.
+type Cgroup struct {
+	ID  uint64
+	Dir string
+}
+
+var (
+	ErrNoCgroupV2   = errors.New("no cgroup v2 membership")
+	ErrRootCgroup   = errors.New("process is in the root cgroup")
+	ErrHybridCgroup = errors.New("the unified hierarchy does not isolate this process on this hybrid cgroup host")
+)
+
+func OwnCgroup() (*Cgroup, error) { return nil, ErrNoCgroupV2 }
+
+func (c *Cgroup) Contains(app.PID) bool { return false }
+
+func (c *Cgroup) String() string { return "" }
