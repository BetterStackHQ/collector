diff --git a/pkg/internal/procs/own_cgroup_linux.go b/pkg/internal/procs/own_cgroup_linux.go
new file mode 100644
index 000000000..68ac44766
--- /dev/null
+++ b/pkg/internal/procs/own_cgroup_linux.go
@@ -0,0 +1,294 @@
+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+//go:build linux
+
+package procs // import "go.opentelemetry.io/obi/pkg/internal/procs"
+
+import (
+	"bufio"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+	"sync"
+	"syscall"
+
+	"golang.org/x/sys/unix"
+
+	"go.opentelemetry.io/obi/pkg/appolly/app"
+)
+
+// Cgroup is the cgroup v2 node this process runs in: its container, when it
+// has one.
+type Cgroup struct {
+	// ID is the kernel's id for the cgroup, the inode number of its directory.
+	// It is what bpf_get_current_cgroup_id() returns for a task in the cgroup
+	// and what a socket such a task creates remembers in sk_cgrp_data.
+	ID uint64
+	// Dir is the cgroup's directory in the cgroup2 filesystem.
+	Dir string
+	// membership is this process's unified-hierarchy line in
+	// /proc/<pid>/cgroup, "0::<path>". The kernel renders that path relative
+	// to the reader's cgroup namespace, so two processes' lines read by the
+	// same reader are equal exactly when the processes share the cgroup,
+	// whether or not the reader is in a private namespace.
+	membership string
+}
+
+var (
+	// ErrNoCgroupV2 means the process has no cgroup v2 membership, or the
+	// hierarchy is not mounted where it can be read.
+	ErrNoCgroupV2 = errors.New("no cgroup v2 membership")
+	// ErrRootCgroup means the process runs in the root of the hierarchy, which
+	// every process on a host without cgroup-managed containers shares, so it
+	// identifies nothing.
+	ErrRootCgroup = errors.New("process is in the root cgroup")
+	// ErrHybridCgroup means the host mounts cgroup v1 controllers next to the
+	// unified hierarchy, and the unified hierarchy does not tell this process's
+	// container apart from the others.
+	ErrHybridCgroup = errors.New("the unified hierarchy does not isolate this process on this hybrid cgroup host")
+)
+
+// The root of a kernfs hierarchy is the first node it allocates an id for.
+const rootCgroupID = 1
+
+const cgroupProcsFile = "cgroup.procs"
+
+// injectable for tests
+var (
+	cgroup2Mounts  = []string{"/sys/fs/cgroup", "/sys/fs/cgroup/unified"}
+	mountInfoPath  = "/proc/self/mountinfo"
+	isCgroup2FS    = statfsIsCgroup2
+	cgroupDirInode = dirInode
+	ownPID         = os.Getpid
+)
+
+var ownCgroup = sync.OnceValues(findOwnCgroup)
+
+// OwnCgroup identifies the cgroup this process runs in. The answer is
+// computed once: a process does not move between cgroups on its own.
+func OwnCgroup() (*Cgroup, error) {
+	return ownCgroup()
+}
+
+func findOwnCgroup() (*Cgroup, error) {
+	pid := app.PID(ownPID())
+	membership, controllers, err := cgroupLines(pid)
+	if err != nil {
+		return nil, err
+	}
+	if err := hybridHierarchyIsolates(membership, controllers); err != nil {
+		return nil, err
+	}
+	mount, err := cgroup2Mount()
+	if err != nil {
+		return nil, err
+	}
+	dir, err := cgroupDirOf(mount, membership, pid)
+	if err != nil {
+		return nil, err
+	}
+	id, err := cgroupDirInode(dir)
+	if err != nil {
+		return nil, fmt.Errorf("identifying cgroup %s: %w", dir, err)
+	}
+	if id == rootCgroupID {
+		return nil, fmt.Errorf("%w: %s", ErrRootCgroup, dir)
+	}
+	return &Cgroup{ID: id, Dir: dir, membership: membership}, nil
+}
+
+// Contains reports whether pid runs in this cgroup. A process that is gone,
+// or whose membership cannot be read, is not in it.
+func (c *Cgroup) Contains(pid app.PID) bool {
+	membership, err := unifiedCgroupLine(pid)
+	return err == nil && membership == c.membership
+}
+
+func (c *Cgroup) String() string {
+	return fmt.Sprintf("%s (id %d)", c.Dir, c.ID)
+}
+
+// unifiedCgroupLine returns the "0::<path>" line of /proc/<pid>/cgroup.
+func unifiedCgroupLine(pid app.PID) (string, error) {
+	unified, _, err := cgroupLines(pid)
+	return unified, err
+}
+
+// cgroupLines reads /proc/<pid>/cgroup: the unified hierarchy's "0::<path>"
+// line, and the cgroup v1 controller lines ("12:memory:<path>") a hybrid
+// host adds next to it.
+func cgroupLines(pid app.PID) (unified string, controllers []string, err error) {
+	path := filepath.Join(procRootPath, strconv.Itoa(int(pid)), "cgroup")
+	f, err := os.Open(path)
+	if err != nil {
+		return "", nil, err
+	}
+	defer f.Close()
+
+	scanner := bufio.NewScanner(f)
+	for scanner.Scan() {
+		line := scanner.Text()
+		if strings.HasPrefix(line, "0::") {
+			unified = line
+		} else if line != "" {
+			controllers = append(controllers, line)
+		}
+	}
+	if err := scanner.Err(); err != nil {
+		return "", nil, err
+	}
+	if unified == "" {
+		return "", nil, fmt.Errorf("%w: %s has no unified hierarchy entry", ErrNoCgroupV2, path)
+	}
+	return unified, controllers, nil
+}
+
+// hybridHierarchyIsolates decides whether, on a host that mounts cgroup v1
+// controllers next to the unified hierarchy, the unified hierarchy still
+// tells containers apart.
+//
+// A systemd-driven runtime creates its scope in every hierarchy, so a
+// process's v1 paths equal its unified path and the unified cgroup is the
+// container. A runtime that only populates the v1 controllers, which is what
+// Docker's cgroupfs driver does and what it defaults to on such hosts, leaves
+// every container's processes in the unified cgroup they inherited from the
+// runtime's own service. "Own cgroup" would then cover every container on
+// the host, so the feature stays off. Behind a private cgroup namespace on
+// such a host every path reads "/" and nothing can be compared, so it stays
+// off there too.
+func hybridHierarchyIsolates(membership string, controllers []string) error {
+	if len(controllers) == 0 {
+		return nil
+	}
+	unifiedPath := strings.TrimPrefix(membership, "0::")
+	if unifiedPath == "/" {
+		return fmt.Errorf("%w: every hierarchy reads as its root", ErrHybridCgroup)
+	}
+	for _, line := range controllers {
+		parts := strings.SplitN(line, ":", 3)
+		if len(parts) != 3 {
+			continue
+		}
+		if parts[2] != unifiedPath {
+			return fmt.Errorf("%w: cgroup v1 %q is at %s, the unified hierarchy at %s",
+				ErrHybridCgroup, parts[1], parts[2], unifiedPath)
+		}
+	}
+	return nil
+}
+
+// cgroup2Mount finds a mount point of the cgroup2 filesystem: the usual places
+// first, then whatever /proc/self/mountinfo lists.
+func cgroup2Mount() (string, error) {
+	for _, mount := range cgroup2Mounts {
+		if isCgroup2FS(mount) {
+			return mount, nil
+		}
+	}
+
+	f, err := os.Open(mountInfoPath)
+	if err != nil {
+		return "", fmt.Errorf("%w: %w", ErrNoCgroupV2, err)
+	}
+	defer f.Close()
+
+	scanner := bufio.NewScanner(f)
+	for scanner.Scan() {
+		// 559 466 0:30 / /sys/fs/cgroup ro,nosuid,nodev,noexec,relatime - cgroup2 cgroup2 rw,nsdelegate
+		fields := strings.Fields(scanner.Text())
+		sep := slices.Index(fields, "-")
+		if sep < 5 || sep+1 >= len(fields) || fields[sep+1] != "cgroup2" {
+			continue
+		}
+		if mount := unescapeMountInfo(fields[4]); isCgroup2FS(mount) {
+			return mount, nil
+		}
+	}
+	if err := scanner.Err(); err != nil {
+		return "", fmt.Errorf("%w: %w", ErrNoCgroupV2, err)
+	}
+	return "", fmt.Errorf("%w: no cgroup2 filesystem mounted", ErrNoCgroupV2)
+}
+
+// mountinfo octal-escapes the characters that would break its format.
+var mountInfoUnescaper = strings.NewReplacer(`\040`, " ", `\011`, "\t", `\012`, "\n", `\134`, `\`)
+
+func unescapeMountInfo(field string) string {
+	return mountInfoUnescaper.Replace(field)
+}
+
+// cgroupDirOf locates pid's cgroup directory under mount.
+//
+// The membership path is relative to this process's cgroup namespace, while
+// the mount shows the hierarchy from the mount's own root, and the two only
+// compose when they agree on that root. They do not when a container runtime
+// bind-mounts the host's whole hierarchy into a private cgroup namespace: the
+// process then reads "0::/" for a cgroup several levels down. So the path is
+// only a first guess, and the directory whose cgroup.procs lists pid is the
+// answer wherever it is.
+func cgroupDirOf(mount, membership string, pid app.PID) (string, error) {
+	candidate := filepath.Join(mount, strings.TrimPrefix(membership, "0::"))
+	if cgroupLists(candidate, pid) {
+		return candidate, nil
+	}
+
+	found := ""
+	err := filepath.WalkDir(mount, func(path string, d fs.DirEntry, err error) error {
+		if err != nil || !d.IsDir() {
+			return nil
+		}
+		if cgroupLists(path, pid) {
+			found = path
+			return fs.SkipAll
+		}
+		return nil
+	})
+	if err != nil {
+		return "", fmt.Errorf("walking %s: %w", mount, err)
+	}
+	if found == "" {
+		return "", fmt.Errorf("%w: pid %d is not listed under %s", ErrNoCgroupV2, pid, mount)
+	}
+	return found, nil
+}
+
+// cgroupLists reports whether dir's cgroup.procs names pid.
+func cgroupLists(dir string, pid app.PID) bool {
+	f, err := os.Open(filepath.Join(dir, cgroupProcsFile))
+	if err != nil {
+		return false
+	}
+	defer f.Close()
+
+	want := strconv.Itoa(int(pid))
+	scanner := bufio.NewScanner(f)
+	for scanner.Scan() {
+		if scanner.Text() == want {
+			return true
+		}
+	}
+	return false
+}
+
+func statfsIsCgroup2(path string) bool {
+	var st unix.Statfs_t
+	return unix.Statfs(path, &st) == nil && st.Type == unix.CGROUP2_SUPER_MAGIC
+}
+
+func dirInode(dir string) (uint64, error) {
+	info, err := os.Stat(dir)
+	if err != nil {
+		return 0, err
+	}
+	st, ok := info.Sys().(*syscall.Stat_t)
+	if !ok {
+		return 0, fmt.Errorf("no inode for %s", dir)
+	}
+	return st.Ino, nil
+}
diff --git a/pkg/internal/procs/own_cgroup_linux_test.go b/pkg/internal/procs/own_cgroup_linux_test.go
new file mode 100644
index 000000000..60296cbf1
--- /dev/null
+++ b/pkg/internal/procs/own_cgroup_linux_test.go
@@ -0,0 +1,227 @@
+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+//go:build linux
+
+package procs
+
+import (
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.opentelemetry.io/obi/pkg/appolly/app"
+)
+
+const fixturePID = 4242
+
+// cgroupFixture fakes /proc and a cgroup2 mount in temporary directories.
+type cgroupFixture struct {
+	proc  string
+	mount string
+}
+
+func newCgroupFixture(t *testing.T) *cgroupFixture {
+	t.Helper()
+	fx := &cgroupFixture{proc: t.TempDir(), mount: t.TempDir()}
+
+	origRoot, origMounts, origInfo := procRootPath, cgroup2Mounts, mountInfoPath
+	origIsFS, origInode, origPID := isCgroup2FS, cgroupDirInode, ownPID
+	t.Cleanup(func() {
+		procRootPath, cgroup2Mounts, mountInfoPath = origRoot, origMounts, origInfo
+		isCgroup2FS, cgroupDirInode, ownPID = origIsFS, origInode, origPID
+	})
+	procRootPath = fx.proc
+	cgroup2Mounts = []string{fx.mount}
+	mountInfoPath = filepath.Join(fx.proc, "self-mountinfo")
+	isCgroup2FS = func(path string) bool { return path == fx.mount }
+	ownPID = func() int { return fixturePID }
+
+	return fx
+}
+
+// process fakes /proc/<pid>/cgroup.
+func (fx *cgroupFixture) process(t *testing.T, pid int, cgroupFile string) {
+	t.Helper()
+	dir := filepath.Join(fx.proc, strconv.Itoa(pid))
+	require.NoError(t, os.MkdirAll(dir, 0o755))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "cgroup"), []byte(cgroupFile), 0o644))
+}
+
+// cgroup fakes a cgroup directory whose cgroup.procs lists pids.
+func (fx *cgroupFixture) cgroup(t *testing.T, rel string, pids ...int) string {
+	t.Helper()
+	dir := filepath.Join(fx.mount, rel)
+	require.NoError(t, os.MkdirAll(dir, 0o755))
+	var procs strings.Builder
+	for _, pid := range pids {
+		procs.WriteString(strconv.Itoa(pid) + "\n")
+	}
+	require.NoError(t, os.WriteFile(filepath.Join(dir, cgroupProcsFile), []byte(procs.String()), 0o644))
+	return dir
+}
+
+func realInode(t *testing.T, dir string) uint64 {
+	t.Helper()
+	ino, err := dirInode(dir)
+	require.NoError(t, err)
+	return ino
+}
+
+func TestOwnCgroupInHostNamespace(t *testing.T) {
+	fx := newCgroupFixture(t)
+	fx.process(t, fixturePID, "0::/system.slice/obi.service\n")
+	fx.cgroup(t, "", 1)
+	fx.cgroup(t, "system.slice", 2)
+	own := fx.cgroup(t, "system.slice/obi.service", fixturePID)
+
+	got, err := findOwnCgroup()
+	require.NoError(t, err)
+	assert.Equal(t, own, got.Dir)
+	assert.Equal(t, realInode(t, own), got.ID)
+	assert.NotEqual(t, uint64(rootCgroupID), got.ID)
+
+	fx.process(t, 7, "0::/system.slice/obi.service\n")
+	fx.process(t, 8, "0::/system.slice/app.service\n")
+	fx.process(t, 9, "0::/system.slice/obi.service/worker\n")
+	assert.True(t, got.Contains(7), "a process in the same cgroup")
+	assert.False(t, got.Contains(8), "a process in a sibling cgroup")
+	assert.False(t, got.Contains(9), "a process in a child cgroup")
+	assert.False(t, got.Contains(10), "a process that is gone")
+}
+
+// A container runtime that bind-mounts the host hierarchy into a private
+// cgroup namespace: the membership reads "0::/" while the cgroup is two
+// levels down the mount, and the mount root lists other processes.
+func TestOwnCgroupBehindPrivateNamespaceBindMount(t *testing.T) {
+	fx := newCgroupFixture(t)
+	fx.process(t, fixturePID, "0::/\n")
+	fx.cgroup(t, "", 1, 2)
+	fx.cgroup(t, "system.slice", 3)
+	own := fx.cgroup(t, "system.slice/docker-0123abcd.scope", 4241, fixturePID, 4243)
+
+	got, err := findOwnCgroup()
+	require.NoError(t, err)
+	assert.Equal(t, own, got.Dir)
+	assert.Equal(t, realInode(t, own), got.ID)
+
+	fx.process(t, 4243, "0::/\n")
+	fx.process(t, 1, "0::/../../init.scope\n")
+	fx.process(t, 3, "0::/../other-0123.scope\n")
+	assert.True(t, got.Contains(4243), "a process in the same container")
+	assert.False(t, got.Contains(1), "a process outside the namespace")
+	assert.False(t, got.Contains(3), "a process in a sibling container")
+}
+
+func TestOwnCgroupRejectsTheHierarchyRoot(t *testing.T) {
+	fx := newCgroupFixture(t)
+	fx.process(t, fixturePID, "0::/\n")
+	fx.cgroup(t, "", 1, fixturePID)
+	cgroupDirInode = func(string) (uint64, error) { return rootCgroupID, nil }
+
+	_, err := findOwnCgroup()
+	require.ErrorIs(t, err, ErrRootCgroup)
+}
+
+func TestOwnCgroupWithoutUnifiedHierarchy(t *testing.T) {
+	fx := newCgroupFixture(t)
+	fx.process(t, fixturePID, "12:memory:/docker/0123abcd\n1:name=systemd:/docker/0123abcd\n")
+	fx.cgroup(t, "", fixturePID)
+
+	_, err := findOwnCgroup()
+	require.ErrorIs(t, err, ErrNoCgroupV2)
+}
+
+func TestOwnCgroupFindsTheMountInMountInfo(t *testing.T) {
+	fx := newCgroupFixture(t)
+	fx.process(t, fixturePID, "0::/obi\n")
+	own := fx.cgroup(t, "obi", fixturePID)
+	cgroup2Mounts = []string{filepath.Join(fx.proc, "nowhere")}
+	require.NoError(t, os.WriteFile(mountInfoPath, []byte(
+		"30 24 0:27 / /sys/fs/cgroup/memory rw,nosuid - cgroup cgroup rw,memory\n"+
+			"559 466 0:30 / "+fx.mount+" ro,nosuid,nodev,noexec,relatime - cgroup2 cgroup2 rw,nsdelegate\n"), 0o644))
+
+	got, err := findOwnCgroup()
+	require.NoError(t, err)
+	assert.Equal(t, own, got.Dir)
+}
+
+func TestOwnCgroupWithoutAnyMount(t *testing.T) {
+	fx := newCgroupFixture(t)
+	fx.process(t, fixturePID, "0::/obi\n")
+	cgroup2Mounts = []string{filepath.Join(fx.proc, "nowhere")}
+	require.NoError(t, os.WriteFile(mountInfoPath, []byte(
+		"30 24 0:27 / /sys/fs/cgroup/memory rw,nosuid - cgroup cgroup rw,memory\n"), 0o644))
+
+	_, err := findOwnCgroup()
+	require.ErrorIs(t, err, ErrNoCgroupV2)
+}
+
+func TestOwnCgroupNotListedAnywhere(t *testing.T) {
+	fx := newCgroupFixture(t)
+	fx.process(t, fixturePID, "0::/\n")
+	fx.cgroup(t, "", 1)
+	fx.cgroup(t, "system.slice/other.scope", 2)
+
+	_, err := findOwnCgroup()
+	require.ErrorIs(t, err, ErrNoCgroupV2)
+}
+
+func TestUnescapeMountInfo(t *testing.T) {
+	assert.Equal(t, "/mnt/with space\\back", unescapeMountInfo(`/mnt/with\040space\134back`))
+}
+
+func TestCgroupContainsUsesTheSameReader(t *testing.T) {
+	fx := newCgroupFixture(t)
+	c := &Cgroup{membership: "0::/a/b"}
+	fx.process(t, 5, "11:pids:/a/b\n0::/a/b\n")
+	fx.process(t, 6, "0::/a/b/c\n")
+	assert.True(t, c.Contains(app.PID(5)))
+	assert.False(t, c.Contains(app.PID(6)))
+}
+
+// A hybrid host whose runtime creates its scope in every hierarchy: the
+// unified cgroup is the container, and the feature works.
+func TestOwnCgroupOnHybridHostWithSystemdDriver(t *testing.T) {
+	fx := newCgroupFixture(t)
+	fx.process(t, fixturePID, "12:memory:/system.slice/docker-0123abcd.scope\n"+
+		"1:name=systemd:/system.slice/docker-0123abcd.scope\n"+
+		"0::/system.slice/docker-0123abcd.scope\n")
+	fx.cgroup(t, "", 1)
+	own := fx.cgroup(t, "system.slice/docker-0123abcd.scope", fixturePID)
+
+	got, err := findOwnCgroup()
+	require.NoError(t, err)
+	assert.Equal(t, own, got.Dir)
+}
+
+// A hybrid host whose runtime only populates the v1 controllers: every
+// container shares the unified cgroup of the runtime's service, so "own
+// cgroup" would cover them all.
+func TestOwnCgroupOnHybridHostWithCgroupfsDriver(t *testing.T) {
+	fx := newCgroupFixture(t)
+	fx.process(t, fixturePID, "12:memory:/docker/0123abcd\n"+
+		"1:name=systemd:/system.slice/containerd.service\n"+
+		"0::/system.slice/containerd.service\n")
+	fx.cgroup(t, "system.slice/containerd.service", fixturePID, 4243, 4244)
+
+	_, err := findOwnCgroup()
+	require.ErrorIs(t, err, ErrHybridCgroup)
+}
+
+// Behind a private cgroup namespace on a hybrid host every path reads as
+// the root, so the two layouts above cannot be told apart.
+func TestOwnCgroupOnHybridHostBehindPrivateNamespace(t *testing.T) {
+	fx := newCgroupFixture(t)
+	fx.process(t, fixturePID, "12:memory:/\n0::/\n")
+	fx.cgroup(t, "", 1)
+	fx.cgroup(t, "system.slice/docker-0123abcd.scope", fixturePID)
+
+	_, err := findOwnCgroup()
+	require.ErrorIs(t, err, ErrHybridCgroup)
+}
