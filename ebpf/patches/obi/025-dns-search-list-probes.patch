+// A resolver with a search list asks for several candidates of one name:
+// `inventory` becomes `inventory.ns.svc.cluster.local.`, `inventory.svc.cluster.local.`,
+// `inventory.cluster.local.` and `inventory.`, and all but one answer NXDOMAIN
+// although the lookup succeeds. glibc walks the whole list for an address
+// family that has no record (AAAA for a service without IPv6), so Ruby and
+// anything else resolving both families separately shows three NXDOMAIN spans
+// per call. Those answers are parked here, per process and first label, until
+// a sibling candidate resolves (then they are emitted as probes, not errors) or
+// the window closes (then they are emitted as they always were, errors).
+type dnsSearchKey struct {
+	HostPID uint32
+	Label   string
+}
+
+const (
+	// dnsSearchWindow bounds how long an NXDOMAIN waits for a sibling and how
+	// long a resolution keeps turning later NXDOMAINs for the same label into
+	// probes. A resolver's walk takes milliseconds; the window only needs to
+	// cover a slow nameserver, and it is also how late a real NXDOMAIN error
+	// is reported.
+	dnsSearchWindow = 2 * time.Second
+	// dnsSearchMaxParked caps what one group holds; a process retrying a
+	// failing name in a loop gets its errors at once past the cap.
+	dnsSearchMaxParked = 64
+)
+
+type dnsSearchGroup struct {
+	mu       sync.Mutex
+	resolved bool           // a candidate answered with addresses inside the window
+	flushed  bool           // the window closed and the parked spans went out as errors
+	parked   []request.Span // NXDOMAIN candidates waiting for a sibling
+}
+
+// dnsSearchLabel is the first label of a question name, lower-cased: every
+// candidate of a search-list walk starts with the name the program asked for.
+func dnsSearchLabel(name string) string {
+	label, _, _ := strings.Cut(strings.TrimSuffix(name, "."), ".")
+	return strings.ToLower(label)
+}
+
+// dnsSearchGroupExpireHandler emits the parked NXDOMAIN answers of a group whose
+// window closed without a sibling resolving: the whole lookup failed, and they
+// are the errors they always were. It runs under the LRU's lock, like the
+// handler for unanswered requests, and like that handler it emits directly.
+func dnsSearchGroupExpireHandler(parseCtx *EBPFParseContext) func(dnsSearchKey, *dnsSearchGroup) {
+	return func(_ dnsSearchKey, group *dnsSearchGroup) {
+		group.mu.Lock()
+		parked := group.parked
+		group.parked = nil
+		group.flushed = true
+		group.mu.Unlock()
+		if len(parked) > 0 && parseCtx.emitSpans != nil {
+			parseCtx.emitSpans(parked)
+		}
+	}
+}
+
+// dnsSearchGroupFor returns the live group for key, starting a new one when
+// there is none. An entry past its window that the cache has not swept yet
+// would be overwritten by Add without its callback, so it is removed first,
+// which flushes it.
+func (ctx *EBPFParseContext) dnsSearchGroupFor(key dnsSearchKey) *dnsSearchGroup {
+	if group, ok := ctx.dnsSearchGroups.Get(key); ok {
+		group.mu.Lock()
+		flushed := group.flushed
+		group.mu.Unlock()
+		if !flushed {
+			return group
+		}
+	}
+	ctx.dnsSearchGroups.Remove(key)
+	group := &dnsSearchGroup{}
+	ctx.dnsSearchGroups.Add(key, group)
+	return group
+}
+
+// parkDNSSearchProbe takes an NXDOMAIN answer. It reports whether the caller
+// emits the span now and, if so, whether as a probe (a sibling already
+// resolved) or as the plain error it is when nothing correlates lookups.
+func (ctx *EBPFParseContext) parkDNSSearchProbe(span request.Span) (emitNow, probe bool) {
+	label := dnsSearchLabel(span.Path)
+	if ctx == nil || ctx.dnsSearchGroups == nil || label == "" {
+		return true, false
+	}
+	key := dnsSearchKey{HostPID: uint32(span.Pid.HostPID), Label: label}
+	group := ctx.dnsSearchGroupFor(key)
+	group.mu.Lock()
+	defer group.mu.Unlock()
+	if group.flushed {
+		return true, false
+	}
+	if group.resolved {
+		return true, true
+	}
+	if len(group.parked) >= dnsSearchMaxParked {
+		return true, false
+	}
+	group.parked = append(group.parked, span)
+	return false, false
+}
+
+// resolveDNSSearch takes an answer with addresses: the lookup succeeded, so the
+// NXDOMAIN candidates parked for it go out as probes, and later ones will too
+// for the rest of the window.
+func (ctx *EBPFParseContext) resolveDNSSearch(span *request.Span) {
+	label := dnsSearchLabel(span.Path)
+	if ctx == nil || ctx.dnsSearchGroups == nil || label == "" {
+		return
+	}
+	key := dnsSearchKey{HostPID: uint32(span.Pid.HostPID), Label: label}
+	group := ctx.dnsSearchGroupFor(key)
+	group.mu.Lock()
+	if group.flushed {
+		group.mu.Unlock()
+		return
+	}
+	group.resolved = true
+	parked := group.parked
+	group.parked = nil
+	group.mu.Unlock()
+	for i := range parked {
+		parked[i].DNSSearchProbe = true
+	}
+	if len(parked) > 0 && ctx.emitSpans != nil {
+		ctx.emitSpans(parked)
+	}
+}
