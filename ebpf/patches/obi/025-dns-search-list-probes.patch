+	_, _, err := readDNSEventIntoSpan(ctx, dnsAnswerRecord(t, 1, "inventory.bookstore-rails.svc.cluster.local.", [4]byte{10, 0, 0, 10}))
+	require.NoError(t, err)
+	time.Sleep(120 * time.Millisecond)
+	assert.Empty(t, emitted.list())
+
+	// and after the window a miss for the same label is an error again
+	span, ignore, err := readDNSEventIntoSpan(ctx, dnsRCodeRecord(t, 2, "inventory.", dnsmessage.TypeA, dnsmessage.RCodeNameError))
+	require.NoError(t, err)
+	assert.True(t, ignore, "parked in a fresh group")
+	_ = span
+	assert.Eventually(t, func() bool { return len(emitted.list()) == 1 && !emitted.list()[0].DNSSearchProbe }, 2*time.Second, 5*time.Millisecond)
+}
