+// emittedSpans records spans emitted out of band, from the reader or the LRU's
+// expiry goroutine.
+type emittedSpans struct {
+	mu    sync.Mutex
+	spans []request.Span
+}
+
+func (e *emittedSpans) add(spans []request.Span) {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	e.spans = append(e.spans, spans...)
+}
+
+func (e *emittedSpans) list() []request.Span {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	return append([]request.Span(nil), e.spans...)
+}
+
+// newDNSSearchParseContext correlates search-list candidates within ttl and
+// records every span emitted out of band.
+func newDNSSearchParseContext(ttl time.Duration) (*EBPFParseContext, *emittedSpans) {
+	emitted := &emittedSpans{}
+	ctx := &EBPFParseContext{
+		dnsEvents: expirable.NewLRU[dnsparser.DNSId, *request.Span](1024, nil, time.Minute),
+		emitSpans: emitted.add,
+	}
+	ctx.dnsSearchGroups = expirable.NewLRU(1024, dnsSearchGroupExpireHandler(ctx), ttl)
+	return ctx, emitted
+}
