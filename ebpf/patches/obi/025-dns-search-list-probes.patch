@@ -0,0 +1,37 @@
+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package tracesgen
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"go.opentelemetry.io/obi/pkg/appolly/app/request"
+	attr "go.opentelemetry.io/obi/pkg/export/attributes/names"
+)
+
+// A DNS span names its response code when it is not NoError, whether or not
+// the span counts as an error.
+func TestTraceAttributesSelector_DNSResponseRCode(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		span  request.Span
+		want  string
+		found bool
+	}{
+		{"nxdomain error", request.Span{Type: request.EventTypeDNS, Method: "AAAA", Path: "nosuch.", Status: 3}, "NXDomain", true},
+		{"nxdomain probe", request.Span{Type: request.EventTypeDNS, Method: "AAAA", Path: "inventory.cluster.local.", Status: 3, DNSSearchProbe: true}, "NXDomain", true},
+		{"noerror", request.Span{Type: request.EventTypeDNS, Method: "A", Path: "inventory.", Status: 0}, "", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			selected := AttrsToMap(TraceAttributesSelector(&tc.span, map[attr.Name]struct{}{}))
+			val, ok := selected.Get("dns.response.rcode")
+			assert.Equal(t, tc.found, ok)
+			if ok {
+				assert.Equal(t, tc.want, val.Str())
+			}
+		})
+	}
+}
