+// validateMsgHeader checks what the wire protocol promises about a header.
+// The ids are any int32: pymongo draws them at random from the whole range,
+// so half of its requests carry a negative one, and the reply echoes it.
 func validateMsgHeader(header *msgHeader) error {
 	if header.MessageLength <= msgHeaderSize || header.OpCode == opMsg && header.MessageLength < minOpMsgSize {
 		return errMongoInvalidMessageLength
 	}
-	if header.RequestID < 0 {
-		return errMongoInvalidRequestID
-	}
-	if header.ResponseTo < 0 {
-		return errMongoInvalidResponseID
-	}
 	return nil
 }
 
