+
+// pymongo draws request ids at random from the whole int32 range; this find
+// carries a negative one and its reply echoes it.
+func TestMongoPymongoNegativeRequestID(t *testing.T) {
+	cache := expirable.NewLRU[MongoRequestKey, *MongoRequestValue](10, nil, 0)
+	conn := getConnInfo()
+	raw := fixture(t, pyFindReq)
+	requestID := int32(binary.LittleEndian.Uint32(raw[4:8]))
+	require.Negative(t, requestID, "the fixture must carry a negative id")
+
+	_, more, err := ProcessMongoEvent(captured(t, pyFindReq), StartTime, EndTime, conn, cache)
+	require.NoError(t, err)
+	assert.True(t, more)
+
+	// the reply, as pymongo reads it: the header first
+	reply := new(bytes.Buffer)
+	_ = binary.Write(reply, binary.LittleEndian, msgHeader{MessageLength: 994, RequestID: 712, ResponseTo: requestID, OpCode: opMsg})
+	req, more, err := ProcessMongoEvent(reply.Bytes(), StartTime, EndTime, conn, cache)
+	require.NoError(t, err)
+	assert.False(t, more)
+	require.NotNil(t, req)
+
+	info, err := getMongoInfo(req)
+	require.NoError(t, err)
+	assert.Equal(t, "find", info.OpName)
+	assert.Equal(t, "pyitems", info.Collection)
+	assert.Equal(t, "shop", info.DB)
+	assert.True(t, info.Success)
+}
+
+func TestMongoNegativeIDsRoundTrip(t *testing.T) {
+	cache := expirable.NewLRU[MongoRequestKey, *MongoRequestValue](10, nil, 0)
+	conn := getConnInfo()
+	request := getRequestPayload(&msgHeader{MessageLength: MessageLength, RequestID: -1610743600, OpCode: opMsg}, 0, sectionTypeBody, nil)
+	_, _, err := ProcessMongoEvent(request, StartTime, EndTime, conn, cache)
+	require.NoError(t, err)
+	response := getResponsePayload(&msgHeader{MessageLength: 38, RequestID: -7, ResponseTo: -1610743600, OpCode: opMsg}, 0, sectionTypeBody, nil)
+	req, more, err := ProcessMongoEvent(response, StartTime, EndTime, conn, cache)
+	require.NoError(t, err)
+	assert.False(t, more)
+	require.NotNil(t, req)
+	info, err := getMongoInfo(req)
+	require.NoError(t, err)
+	assert.Equal(t, "find", info.OpName)
+	assert.True(t, info.Success)
+}
