+func TestTraceAttributesSelector_MongoQueryText(t *testing.T) {
+	span := &request.Span{
+		Type:        request.EventTypeMongoClient,
+		Method:      "find",
+		Path:        "items",
+		DBNamespace: "shop",
+		Statement:   `{"find": "items", "filter": {"type": ?}}`,
+	}
+
+	// not selected: the shape of the query is not emitted
+	emptyAttrs := TraceAttributesSelector(span, map[attr.Name]struct{}{})
+	assert.Contains(t, emptyAttrs, request.DBOperationName("find"))
+	assert.Contains(t, emptyAttrs, request.DBCollectionName("items"))
+	assert.NotContains(t, emptyAttrs, request.DBQueryText(span.Statement))
+
+	optInAttrs := TraceAttributesSelector(span, map[attr.Name]struct{}{attr.DBQueryText: {}})
+	assert.Contains(t, optInAttrs, request.DBQueryText(span.Statement))
+}
