+// Only a collection command keeps its first value; anything else is data.
+func TestMongoQueryTextKeepsOnlyCollectionNames(t *testing.T) {
+	assert.Equal(t, `{"createUser": ?, "pwd": ?, "roles": [{"role": ?, "db": ?}]}`,
+		mongoQueryText(bson.D{{Key: "createUser", Value: "alice"}, {Key: "pwd", Value: "s3cret"}, {Key: "roles", Value: bson.A{bson.D{{Key: "role", Value: "readWrite"}, {Key: "db", Value: "shop"}}}}}, false))
+	assert.Equal(t, `{"logApplicationMessage": ?}`, mongoQueryText(bson.D{{Key: "logApplicationMessage", Value: "free text"}}, false))
+	assert.Equal(t, `{"createIndexes": "items", "indexes": [{"key": {"title": ?}, "name": ?}]}`,
+		mongoQueryText(bson.D{{Key: "createIndexes", Value: "items"}, {Key: "indexes", Value: bson.A{bson.D{{Key: "key", Value: bson.D{{Key: "title", Value: int32(1)}}}, {Key: "name", Value: "title_1"}}}}}, false))
+	assert.Equal(t, `{"aggregate": ?, "pipeline": [{"$currentOp": {}}]}`,
+		mongoQueryText(bson.D{{Key: "aggregate", Value: int32(1)}, {Key: "pipeline", Value: bson.A{bson.D{{Key: "$currentOp", Value: bson.D{}}}}}}, false))
+	// a regex pattern is a value, not shown
+	assert.Equal(t, `{"find": "items", "filter": {"title": ?}}`,
+		mongoQueryText(bson.D{{Key: "find", Value: "items"}, {Key: "filter", Value: bson.D{{Key: "title", Value: bsonOpaque{Type: bsonTypeRegex}}}}}, false))
+}
