diff --git a/pkg/ebpf/common/mongo_bson_partial.go b/pkg/ebpf/common/mongo_bson_partial.go
new file mode 100644
index 000000000..ee51aad9f
--- /dev/null
+++ b/pkg/ebpf/common/mongo_bson_partial.go
@@ -0,0 +1,358 @@
+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package ebpfcommon // import "go.opentelemetry.io/obi/pkg/ebpf/common"
+
+import (
+	"bytes"
+	"encoding/binary"
+	"math"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"go.mongodb.org/mongo-driver/v2/bson"
+)
+
+// Reading what a cut-short capture still holds.
+//
+// The generic TCP tracer hands the parser the first bytes of a message, not the
+// message: 256 of a request and 128 of a reply (k_tcp_max_len, k_tcp_res_len)
+// unless buffer_sizes.tcp raises them. A find reply
+// with ten documents, or a request that carries a session, a cluster time and
+// a read preference on top of its filter, is longer than that, and
+// bson.Unmarshal refuses a document whose declared length exceeds the bytes it
+// is given. The command name and the collection are the first element of the
+// request body, "$db" is near the end, and "ok" is the last field of a reply;
+// so the part that names the span is almost always present, and the part that
+// is missing is almost always data. This walk decodes a BSON document prefix
+// element by element, keeping every element that is complete and descending
+// into embedded documents and arrays the same way, and reports whether it ran
+// out of bytes.
+
+const (
+	bsonTypeDouble        = 0x01
+	bsonTypeString        = 0x02
+	bsonTypeDocument      = 0x03
+	bsonTypeArray         = 0x04
+	bsonTypeBinary        = 0x05
+	bsonTypeUndefined     = 0x06
+	bsonTypeObjectID      = 0x07
+	bsonTypeBool          = 0x08
+	bsonTypeDateTime      = 0x09
+	bsonTypeNull          = 0x0A
+	bsonTypeRegex         = 0x0B
+	bsonTypeDBPointer     = 0x0C
+	bsonTypeJavaScript    = 0x0D
+	bsonTypeSymbol        = 0x0E
+	bsonTypeCodeWithScope = 0x0F
+	bsonTypeInt32         = 0x10
+	bsonTypeTimestamp     = 0x11
+	bsonTypeInt64         = 0x12
+	bsonTypeDecimal128    = 0x13
+	bsonTypeMinKey        = 0xFF
+	bsonTypeMaxKey        = 0x7F
+)
+
+// bsonOpaque stands in for a value whose content the span never needs.
+type bsonOpaque struct {
+	Type byte
+}
+
+// Deeper than any real command; what is below is data, kept opaque. Bounds the
+// stack an adversarial document can cost.
+const bsonMaxDepth = 32
+
+// bsonPrefix decodes the complete top-level elements of a BSON document that
+// buf may hold only the beginning of. The returned document is what
+// bson.Unmarshal would have produced for those elements, as far as the span
+// needs values: strings, numbers and booleans are decoded, embedded documents
+// and arrays are walked, anything else is opaque. truncated reports that the
+// document continued past buf, in which case the last embedded document or
+// array may itself be a prefix.
+func bsonPrefix(buf []byte) (doc bson.D, truncated bool) {
+	return bsonPrefixAt(buf, 0)
+}
+
+func bsonPrefixAt(buf []byte, depth int) (doc bson.D, truncated bool) {
+	if len(buf) < 4 {
+		return nil, true
+	}
+	declared := int(int32(binary.LittleEndian.Uint32(buf)))
+	if declared < 5 {
+		return nil, true
+	}
+	if declared > len(buf) {
+		truncated = true
+	} else {
+		buf = buf[:declared]
+	}
+
+	off := 4
+	for off < len(buf) {
+		elementType := buf[off]
+		if elementType == 0 {
+			// the terminator: a complete document
+			return doc, truncated
+		}
+		off++
+		keyEnd := bytes.IndexByte(buf[off:], 0)
+		if keyEnd < 0 {
+			return doc, true
+		}
+		key := string(buf[off : off+keyEnd])
+		off += keyEnd + 1
+
+		value, size, complete := bsonValue(elementType, buf[off:], depth)
+		if value != nil || complete {
+			doc = append(doc, bson.E{Key: key, Value: value})
+		}
+		if !complete {
+			return doc, true
+		}
+		off += size
+	}
+	return doc, true
+}
+
+// bsonValue decodes one element value of the given type from the start of b.
+// It returns the value, how many bytes it took, and whether all of it was
+// there. A cut embedded document or array still yields its readable prefix,
+// with complete false.
+func bsonValue(elementType byte, b []byte, depth int) (value any, size int, complete bool) {
+	fixed := func(n int, v func([]byte) any) (any, int, bool) {
+		if len(b) < n {
+			return nil, 0, false
+		}
+		return v(b[:n]), n, true
+	}
+	opaque := func([]byte) any { return bsonOpaque{Type: elementType} }
+
+	switch elementType {
+	case bsonTypeDouble:
+		return fixed(8, func(v []byte) any { return math.Float64frombits(binary.LittleEndian.Uint64(v)) })
+	case bsonTypeString, bsonTypeJavaScript, bsonTypeSymbol:
+		if len(b) < 4 {
+			return nil, 0, false
+		}
+		n := int(int32(binary.LittleEndian.Uint32(b)))
+		if n < 1 || len(b) < 4+n {
+			return nil, 0, false
+		}
+		s := string(b[4 : 4+n-1])
+		switch elementType {
+		case bsonTypeJavaScript:
+			return bson.JavaScript(s), 4 + n, true
+		case bsonTypeSymbol:
+			return bson.Symbol(s), 4 + n, true
+		default:
+			return s, 4 + n, true
+		}
+	case bsonTypeDocument, bsonTypeArray:
+		if len(b) < 4 {
+			return nil, 0, false
+		}
+		n := int(int32(binary.LittleEndian.Uint32(b)))
+		if n < 5 {
+			return nil, 0, false
+		}
+		if depth >= bsonMaxDepth {
+			if n > len(b) {
+				return nil, 0, false
+			}
+			return bsonOpaque{Type: elementType}, n, true
+		}
+		if n > len(b) {
+			sub, _ := bsonPrefixAt(b, depth+1)
+			return bsonContainer(elementType, sub), len(b), false
+		}
+		sub, cut := bsonPrefixAt(b[:n], depth+1)
+		return bsonContainer(elementType, sub), n, !cut
+	case bsonTypeBinary:
+		if len(b) < 5 {
+			return nil, 0, false
+		}
+		n := int(int32(binary.LittleEndian.Uint32(b)))
+		if n < 0 || len(b) < 5+n {
+			return nil, 0, false
+		}
+		return bsonOpaque{Type: elementType}, 5 + n, true
+	case bsonTypeUndefined, bsonTypeNull, bsonTypeMinKey, bsonTypeMaxKey:
+		return bsonOpaque{Type: elementType}, 0, true
+	case bsonTypeObjectID:
+		return fixed(12, opaque)
+	case bsonTypeBool:
+		return fixed(1, func(v []byte) any { return v[0] != 0 })
+	case bsonTypeDateTime:
+		return fixed(8, func(v []byte) any { return bson.DateTime(binary.LittleEndian.Uint64(v)) })
+	case bsonTypeTimestamp:
+		return fixed(8, opaque)
+	case bsonTypeInt32:
+		return fixed(4, func(v []byte) any { return int32(binary.LittleEndian.Uint32(v)) })
+	case bsonTypeInt64:
+		return fixed(8, func(v []byte) any { return int64(binary.LittleEndian.Uint64(v)) })
+	case bsonTypeDecimal128:
+		return fixed(16, opaque)
+	case bsonTypeRegex:
+		pattern := bytes.IndexByte(b, 0)
+		if pattern < 0 {
+			return nil, 0, false
+		}
+		options := bytes.IndexByte(b[pattern+1:], 0)
+		if options < 0 {
+			return nil, 0, false
+		}
+		return bsonOpaque{Type: elementType}, pattern + 1 + options + 1, true
+	case bsonTypeDBPointer:
+		if len(b) < 4 {
+			return nil, 0, false
+		}
+		n := int(int32(binary.LittleEndian.Uint32(b)))
+		if n < 1 || len(b) < 4+n+12 {
+			return nil, 0, false
+		}
+		return bsonOpaque{Type: elementType}, 4 + n + 12, true
+	case bsonTypeCodeWithScope:
+		if len(b) < 4 {
+			return nil, 0, false
+		}
+		n := int(int32(binary.LittleEndian.Uint32(b)))
+		if n < 4 || len(b) < n {
+			return nil, 0, false
+		}
+		return bsonOpaque{Type: elementType}, n, true
+	default:
+		// not BSON after all; stop here
+		return nil, 0, false
+	}
+}
+
+func bsonContainer(elementType byte, doc bson.D) any {
+	if elementType != bsonTypeArray {
+		return doc
+	}
+	arr := make(bson.A, 0, len(doc))
+	for _, e := range doc {
+		arr = append(arr, e.Value)
+	}
+	return arr
+}
+
+// What db.query.text says about a command.
+//
+// The shape of the command, with every value replaced by "?": field names and
+// operators tell a reader which query is slow, the values would tell them
+// whose. The collection a collection command names stays, it is the target
+// rather than data; the first value of any other command (a user name for
+// createUser, free text for logApplicationMessage) does not. Field names are
+// kept as SQL identifiers are, including ones an application derives from
+// data. Session and routing fields say nothing about the query and are left
+// out.
+
+const mongoQueryTextMaxLen = 2048
+
+var mongoQueryNoise = map[string]struct{}{
+	"lsid":                 {},
+	"$clusterTime":         {},
+	"$db":                  {},
+	"$readPreference":      {},
+	"txnNumber":            {},
+	"autocommit":           {},
+	"startTransaction":     {},
+	"apiVersion":           {},
+	"apiStrict":            {},
+	"apiDeprecationErrors": {},
+}
+
+// mongoQueryText renders a request body for db.query.text. partial marks a
+// body the capture cut short, which the text ends with an ellipsis for.
+func mongoQueryText(body bson.D, partial bool) string {
+	if len(body) == 0 {
+		return ""
+	}
+	var sb strings.Builder
+	sb.WriteByte('{')
+	first := true
+	for i, e := range body {
+		if _, noise := mongoQueryNoise[e.Key]; noise {
+			continue
+		}
+		if !first {
+			sb.WriteString(", ")
+		}
+		first = false
+		sb.WriteString(strconv.Quote(e.Key))
+		sb.WriteString(": ")
+		if i == 0 && namesACollection(e.Key) {
+			if collection, ok := e.Value.(string); ok {
+				sb.WriteString(strconv.Quote(collection))
+				continue
+			}
+		}
+		writeMongoQueryValue(&sb, e.Value)
+	}
+	sb.WriteByte('}')
+	if partial {
+		sb.WriteString("…")
+	}
+	text := sb.String()
+	if len(text) > mongoQueryTextMaxLen {
+		n := mongoQueryTextMaxLen
+		// never cut a character in half: the attribute has to stay valid UTF-8
+		for n > 0 && !utf8.RuneStart(text[n]) {
+			n--
+		}
+		text = text[:n] + "…"
+	}
+	return text
+}
+
+// collectionAdminCommands name a collection in their first value without
+// touching its data, like the CRUD commands isCollectionCommand lists.
+var collectionAdminCommands = map[string]struct{}{
+	"create":           {},
+	"drop":             {},
+	"createIndexes":    {},
+	"dropIndexes":      {},
+	"listIndexes":      {},
+	"collStats":        {},
+	"validate":         {},
+	"renameCollection": {},
+	"killCursors":      {},
+}
+
+func namesACollection(command string) bool {
+	if isCollectionCommand(command) {
+		return true
+	}
+	_, ok := collectionAdminCommands[command]
+	return ok
+}
+
+func writeMongoQueryValue(sb *strings.Builder, value any) {
+	switch v := value.(type) {
+	case bson.D:
+		sb.WriteByte('{')
+		for i, e := range v {
+			if i > 0 {
+				sb.WriteString(", ")
+			}
+			sb.WriteString(strconv.Quote(e.Key))
+			sb.WriteString(": ")
+			writeMongoQueryValue(sb, e.Value)
+		}
+		sb.WriteByte('}')
+	case bson.A:
+		// the first element shows the shape, the rest would repeat it
+		sb.WriteByte('[')
+		if len(v) > 0 {
+			writeMongoQueryValue(sb, v[0])
+			if len(v) > 1 {
+				sb.WriteString(", ...")
+			}
+		}
+		sb.WriteByte(']')
+	default:
+		sb.WriteByte('?')
+	}
+}
diff --git a/pkg/ebpf/common/mongo_bson_partial_test.go b/pkg/ebpf/common/mongo_bson_partial_test.go
new file mode 100644
index 000000000..14b6e4849
--- /dev/null
+++ b/pkg/ebpf/common/mongo_bson_partial_test.go
@@ -0,0 +1,424 @@
+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package ebpfcommon
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/hex"
+	"strconv"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/hashicorp/golang-lru/v2/expirable"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.mongodb.org/mongo-driver/v2/bson"
+)
+
+// real driver messages captured with strace on the test host (mongodb npm 6.12, pymongo 4.15, MongoDB 8.2)
+const (
+	nodeInsertReq  = ""                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 // 210 bytes
+	nodeInsertResp = "2d000000b602000026010000dd070000000000000018000000106e0001000000016f6b00000000000000f03f00"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           // 45 bytes
+	nodeFindReq    = ""                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             // 180 bytes
+	nodeFindResp   = "" // 994 bytes
+	pyInsertReq    = ""                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     // 208 bytes
+)
+
+// What the generic tracer hands the parser unless buffer_sizes.tcp raises
+// it: k_tcp_max_len bytes of a request and k_tcp_res_len of a reply
+// (bpf/common/common.h).
+const (
+	tcpCaptureLen      = 256
+	tcpReplyCaptureLen = 128
+)
+
+func fixture(t *testing.T, h string) []byte {
+	t.Helper()
+	b, err := hex.DecodeString(h)
+	require.NoError(t, err)
+	return b
+}
+
+func captured(t *testing.T, h string) []byte {
+	b := fixture(t, h)
+	if len(b) > tcpCaptureLen {
+		b = b[:tcpCaptureLen]
+	}
+	return b
+}
+
+func capturedReply(t *testing.T, h string) []byte {
+	b := fixture(t, h)
+	if len(b) > tcpReplyCaptureLen {
+		b = b[:tcpReplyCaptureLen]
+	}
+	return b
+}
+
+// A driver that reads the whole reply at once hands the parser a cut find
+// reply: ten documents come before "ok". The span is still named by its
+// request, with the query's shape.
+func TestMongoNodeFindReplyCutByCapture(t *testing.T) {
+	cache := expirable.NewLRU[MongoRequestKey, *MongoRequestValue](10, nil, 0)
+	conn := getConnInfo()
+
+	_, more, err := ProcessMongoEvent(captured(t, nodeFindReq), StartTime, EndTime, conn, cache)
+	require.NoError(t, err)
+	assert.True(t, more)
+
+	reply := capturedReply(t, nodeFindResp)
+	require.Len(t, reply, tcpReplyCaptureLen, "the reply is longer than the capture")
+	req, more, err := ProcessMongoEvent(reply, StartTime, EndTime, conn, cache)
+	require.NoError(t, err)
+	assert.False(t, more)
+	require.NotNil(t, req)
+	assert.True(t, req.ResponseSections[0].Partial)
+
+	info, err := getMongoInfo(req)
+	require.NoError(t, err)
+	assert.Equal(t, "find", info.OpName)
+	assert.Equal(t, "items", info.Collection)
+	assert.Equal(t, "shop", info.DB)
+	assert.True(t, info.Success, "a reply cut before its ok field is a success whose data was not captured")
+	assert.Equal(t, `{"find": "items", "filter": {"type": ?, "title": {"$regex": ?}}, "sort": {"at": ?}, "limit": ?}`, info.Query)
+}
+
+// The request itself cut inside the filter, as a longer command would be:
+// the span keeps its name and collection, the query text says it was cut,
+// and the database is not known.
+func TestMongoFindRequestCutByCapture(t *testing.T) {
+	cache := expirable.NewLRU[MongoRequestKey, *MongoRequestValue](10, nil, 0)
+	conn := getConnInfo()
+
+	raw := fixture(t, nodeFindReq)
+	// everything up to and including the filter document; "sort" is next
+	cut := raw[:bytes.Index(raw, []byte("sort"))-1]
+	_, more, err := ProcessMongoEvent(cut, StartTime, EndTime, conn, cache)
+	require.NoError(t, err)
+	assert.True(t, more)
+	req, _, err := ProcessMongoEvent(capturedReply(t, nodeFindResp), StartTime, EndTime, conn, cache)
+	require.NoError(t, err)
+	require.NotNil(t, req)
+	assert.True(t, req.RequestSections[0].Partial)
+
+	info, err := getMongoInfo(req)
+	require.NoError(t, err)
+	assert.Equal(t, "find", info.OpName)
+	assert.Equal(t, "items", info.Collection)
+	assert.Empty(t, info.DB)
+	assert.Equal(t, `{"find": "items", "filter": {"type": ?, "title": {"$regex": ?}}}…`, info.Query)
+}
+
+func TestMongoNodeInsertWithDocumentsInBody(t *testing.T) {
+	cache := expirable.NewLRU[MongoRequestKey, *MongoRequestValue](10, nil, 0)
+	conn := getConnInfo()
+
+	_, _, err := ProcessMongoEvent(captured(t, nodeInsertReq), StartTime, EndTime, conn, cache)
+	require.NoError(t, err)
+	req, _, err := ProcessMongoEvent(capturedReply(t, nodeInsertResp), StartTime, EndTime, conn, cache)
+	require.NoError(t, err)
+	require.NotNil(t, req)
+
+	info, err := getMongoInfo(req)
+	require.NoError(t, err)
+	assert.Equal(t, "insert", info.OpName)
+	assert.Equal(t, "items", info.Collection)
+	assert.Equal(t, "shop", info.DB)
+	assert.True(t, info.Success)
+	assert.Equal(t, `{"insert": "items", "documents": [{"type": ?, "title": ?, "qty": ?, "at": ?, "_id": ?}], "ordered": ?}`, info.Query)
+}
+
+// pymongo sends the documents of an insert as a kind-1 section, which the
+// parser skips; the body still names the command.
+func TestMongoPymongoInsertWithDocumentSequence(t *testing.T) {
+	cache := expirable.NewLRU[MongoRequestKey, *MongoRequestValue](10, nil, 0)
+	conn := getConnInfo()
+	// pymongo picks random request ids; this one happens to be positive
+	_, more, err := ProcessMongoEvent(captured(t, pyInsertReq), StartTime, EndTime, conn, cache)
+	require.NoError(t, err)
+	assert.True(t, more)
+	key := MongoRequestKey{connInfo: conn, requestID: 1610743600}
+	req, ok := cache.Peek(key)
+	require.True(t, ok)
+	info, err := getMongoInfo(req)
+	require.NoError(t, err)
+	assert.Equal(t, "insert", info.OpName)
+	assert.Equal(t, "pyitems", info.Collection)
+	assert.Equal(t, "shop", info.DB)
+	assert.Equal(t, `{"insert": "pyitems", "ordered": ?}`, info.Query)
+}
+
+func TestMongoGetMoreNamesItsCollection(t *testing.T) {
+	body := bson.D{{Key: "getMore", Value: int64(8012345)}, {Key: "collection", Value: "items"}, {Key: "batchSize", Value: int32(100)}, {Key: "$db", Value: "shop"}}
+	info, err := getMongoInfo(&MongoRequestValue{RequestSections: []mongoSection{{Type: sectionTypeBody, Body: body}}})
+	require.NoError(t, err)
+	assert.Equal(t, "getMore", info.OpName)
+	assert.Equal(t, "items", info.Collection)
+	assert.Equal(t, `{"getMore": ?, "collection": ?, "batchSize": ?}`, info.Query)
+}
+
+// An error reply names itself up front, so it survives the cut.
+func TestMongoCutErrorReplyIsAFailure(t *testing.T) {
+	body := bson.D{{Key: "ok", Value: 0.0}, {Key: "errmsg", Value: "ns not found"}, {Key: "code", Value: int32(26)}, {Key: "codeName", Value: "NamespaceNotFound"}}
+	info, err := getMongoInfo(&MongoRequestValue{
+		RequestSections:  []mongoSection{{Type: sectionTypeBody, Body: bson.D{{Key: "find", Value: "items"}}}},
+		ResponseSections: []mongoSection{{Type: sectionTypeBody, Body: body, Partial: true}},
+	})
+	require.NoError(t, err)
+	assert.False(t, info.Success)
+	assert.Equal(t, 26, info.ErrorCode)
+
+	// cut before "ok" is seen but with the error message visible
+	info, err = getMongoInfo(&MongoRequestValue{
+		RequestSections:  []mongoSection{{Type: sectionTypeBody, Body: bson.D{{Key: "find", Value: "items"}}}},
+		ResponseSections: []mongoSection{{Type: sectionTypeBody, Body: bson.D{{Key: "errmsg", Value: "ns not found"}}, Partial: true}},
+	})
+	require.NoError(t, err)
+	assert.False(t, info.Success)
+}
+
+// A complete reply without "ok" is not a MongoDB reply the parser understands.
+func TestMongoCompleteReplyWithoutOkIsRejected(t *testing.T) {
+	_, err := getMongoInfo(&MongoRequestValue{
+		RequestSections:  []mongoSection{{Type: sectionTypeBody, Body: bson.D{{Key: "find", Value: "items"}}}},
+		ResponseSections: []mongoSection{{Type: sectionTypeBody, Body: bson.D{{Key: "n", Value: int32(1)}}}},
+	})
+	require.ErrorIs(t, err, errMongoNoOkField)
+}
+
+func TestBsonPrefixMatchesUnmarshalOnCompleteDocuments(t *testing.T) {
+	doc := bson.D{
+		{Key: "find", Value: "items"},
+		{Key: "filter", Value: bson.D{{Key: "type", Value: "order"}, {Key: "title", Value: bson.D{{Key: "$regex", Value: "wid"}}}}},
+		{Key: "sort", Value: bson.D{{Key: "at", Value: int32(-1)}}},
+		{Key: "limit", Value: int64(10)},
+		{Key: "ok", Value: 1.0},
+		{Key: "flag", Value: true},
+		{Key: "ids", Value: bson.A{int32(1), int32(2)}},
+	}
+	raw, err := bson.Marshal(doc)
+	require.NoError(t, err)
+
+	got, truncated := bsonPrefix(raw)
+	assert.False(t, truncated)
+	assert.Equal(t, doc, got)
+}
+
+func TestBsonPrefixStopsAtTheCut(t *testing.T) {
+	doc := bson.D{
+		{Key: "find", Value: "items"},
+		{Key: "filter", Value: bson.D{{Key: "type", Value: "order"}, {Key: "title", Value: "a long title that gets cut"}}},
+		{Key: "$db", Value: "shop"},
+	}
+	raw, err := bson.Marshal(doc)
+	require.NoError(t, err)
+
+	for cut := 0; cut < len(raw); cut++ {
+		got, truncated := bsonPrefix(raw[:cut])
+		assert.True(t, truncated, "cut at %d", cut)
+		if cut > 4+1+5+4+6 {
+			// past the first element, the command name is there
+			require.NotEmpty(t, got, "cut at %d", cut)
+			assert.Equal(t, bson.E{Key: "find", Value: "items"}, got[0], "cut at %d", cut)
+		}
+		// only the document terminator may be missing for "$db" to be complete
+		if cut < len(raw)-1 {
+			for _, e := range got {
+				assert.NotEqual(t, "$db", e.Key, "a cut string must not be reported, cut at %d", cut)
+			}
+		}
+	}
+}
+
+func TestBsonPrefixStopsAtUnknownType(t *testing.T) {
+	raw, err := bson.Marshal(bson.D{{Key: "find", Value: "items"}, {Key: "x", Value: int32(1)}})
+	require.NoError(t, err)
+	// corrupt the second element's type byte
+	raw[4+1+5+4+6] = 0x42
+	got, truncated := bsonPrefix(raw)
+	assert.True(t, truncated)
+	assert.Equal(t, bson.D{{Key: "find", Value: "items"}}, got)
+}
+
+func TestMongoQueryTextCapsItsLength(t *testing.T) {
+	var doc bson.D
+	doc = append(doc, bson.E{Key: "find", Value: "items"})
+	for i := 0; i < 500; i++ {
+		doc = append(doc, bson.E{Key: "field_number_" + string(rune('a'+i%26)) + "_padding_padding", Value: int32(i)})
+	}
+	text := mongoQueryText(doc, false)
+	assert.LessOrEqual(t, len(text), mongoQueryTextMaxLen+len("…"))
+	assert.True(t, len(text) > mongoQueryTextMaxLen)
+}
+
+// The walk reads untrusted bytes with a declared length it cannot trust; it
+// must neither index past the buffer nor loop.
+func FuzzBsonPrefix(f *testing.F) {
+	for _, h := range []string{nodeFindReq, nodeFindResp, nodeInsertReq, pyInsertReq} {
+		raw, err := hex.DecodeString(h)
+		if err != nil {
+			f.Fatal(err)
+		}
+		body := raw[21:]
+		for prefix := 0; prefix <= len(body); prefix += 7 {
+			f.Add(body[:prefix])
+		}
+		f.Add(body)
+	}
+	f.Add([]byte{5, 0, 0, 0, 0})
+	f.Add([]byte{0xff, 0xff, 0xff, 0x7f, 0x02, 'a', 0, 0xff, 0xff, 0xff, 0x7f})
+
+	f.Fuzz(func(t *testing.T, body []byte) {
+		if len(body) > 4096 {
+			return
+		}
+		doc, truncated := bsonPrefix(body)
+		text := mongoQueryText(doc, truncated)
+		if len(text) > mongoQueryTextMaxLen+len("…") {
+			t.Fatalf("query text of %d bytes", len(text))
+		}
+		section := mongoSection{Type: sectionTypeBody, Body: doc, Partial: truncated}
+		_, _ = getMongoInfo(&MongoRequestValue{RequestSections: []mongoSection{section}, ResponseSections: []mongoSection{section}})
+	})
+}
