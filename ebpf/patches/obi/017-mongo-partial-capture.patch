+
+// A complete body the library rejects is salvaged, but it was not cut.
+func TestMongoUnreadableCompleteBodyIsNotPartial(t *testing.T) {
+	raw, err := bson.Marshal(bson.D{{Key: "find", Value: "items"}, {Key: "x", Value: int32(1)}})
+	require.NoError(t, err)
+	raw[len(raw)-1] = 0x42 // no terminator: bson.Unmarshal refuses it
+	doc, n, partial, err := parseBodySection(raw, false)
+	require.NoError(t, err)
+	assert.Equal(t, len(raw), n)
+	assert.False(t, partial)
+	assert.Equal(t, bson.D{{Key: "find", Value: "items"}, {Key: "x", Value: int32(1)}}, doc)
+}
+
+// JavaScript and symbol values keep the types bson.Unmarshal gives them, so a
+// command whose first value is code is not mistaken for a collection name.
+func TestBsonPrefixDecodesCodeAsCode(t *testing.T) {
+	raw, err := bson.Marshal(bson.D{{Key: "$where", Value: bson.JavaScript("this.a > 1")}, {Key: "s", Value: bson.Symbol("sym")}})
+	require.NoError(t, err)
+	doc, truncated := bsonPrefix(raw)
+	assert.False(t, truncated)
+	assert.Equal(t, bson.D{{Key: "$where", Value: bson.JavaScript("this.a > 1")}, {Key: "s", Value: bson.Symbol("sym")}}, doc)
+}
+
+func TestBsonPrefixBoundsNesting(t *testing.T) {
+	// a document nested far deeper than any command, built from the inside out
+	inner, err := bson.Marshal(bson.D{{Key: "v", Value: int32(1)}})
+	require.NoError(t, err)
+	for i := 0; i < 200; i++ {
+		inner, err = bson.Marshal(bson.D{{Key: "d", Value: bson.Raw(inner)}})
+		require.NoError(t, err)
+	}
+	doc, truncated := bsonPrefix(inner)
+	assert.False(t, truncated)
+	require.Len(t, doc, 1)
+	assert.NotPanics(t, func() { _ = mongoQueryText(doc, false) })
+}
