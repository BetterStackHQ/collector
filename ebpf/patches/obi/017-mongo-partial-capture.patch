+func TestMongoQueryTextCapStaysValidUTF8(t *testing.T) {
+	for pad := 0; pad < 8; pad++ {
+		doc := bson.D{{Key: "find", Value: "items"}, {Key: strings.Repeat("p", pad), Value: int32(1)}}
+		for i := 0; i < 400; i++ {
+			doc = append(doc, bson.E{Key: "ключ_" + strconv.Itoa(i), Value: int32(i)})
+		}
+		text := mongoQueryText(doc, true)
+		assert.True(t, utf8.ValidString(text), "pad %d", pad)
+		assert.LessOrEqual(t, len(text), mongoQueryTextMaxLen+len("…"))
+		assert.True(t, strings.HasSuffix(text, "…"))
+	}
+}
