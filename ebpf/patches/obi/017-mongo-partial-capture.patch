+// pymongo spells the legacy heartbeat "ismaster"; it is not a span either.
+func TestMongoLowercaseIsMasterIsAHeartbeat(t *testing.T) {
+	body := bson.D{{Key: "ismaster", Value: int32(1)}, {Key: "helloOk", Value: true}, {Key: "$db", Value: "admin"}}
+	_, err := getMongoInfo(&MongoRequestValue{RequestSections: []mongoSection{{Type: sectionTypeBody, Body: body}}})
+	require.ErrorIs(t, err, errMongoHeartbeatIgnored)
+}
+
+// pymongo, Java and C# send an insert's documents as a kind-1 section after
+// the body; one longer than the capture used to fail the whole message.
+func TestMongoDocumentSequenceCutByCapture(t *testing.T) {
+	body, err := bson.Marshal(bson.D{{Key: "insert", Value: "pyitems"}, {Key: "ordered", Value: true}, {Key: "$db", Value: "shop"}})
+	require.NoError(t, err)
+	document, err := bson.Marshal(bson.D{{Key: "title", Value: strings.Repeat("x", 300)}})
+	require.NoError(t, err)
+	sequence := append([]byte("documents\x00"), document...)
+	sequence = binary.LittleEndian.AppendUint32(nil, uint32(4+len(sequence)))[:4:4]
+	sequence = append(sequence, []byte("documents\x00")...)
+	sequence = append(sequence, document...)
+
+	msg := new(bytes.Buffer)
+	_ = binary.Write(msg, binary.LittleEndian, msgHeader{MessageLength: int32(msgHeaderSize + int32Size + 1 + len(body) + 1 + len(sequence)), RequestID: 7, OpCode: opMsg})
+	_ = binary.Write(msg, binary.LittleEndian, int32(0))
+	msg.WriteByte(byte(sectionTypeBody))
+	msg.Write(body)
+	msg.WriteByte(byte(sectionTypeDocumentSequence))
+	msg.Write(sequence)
+	raw := msg.Bytes()
+	require.Greater(t, len(raw), tcpCaptureLen)
+
+	cache := expirable.NewLRU[MongoRequestKey, *MongoRequestValue](10, nil, 0)
+	conn := getConnInfo()
+	_, more, err := ProcessMongoEvent(raw[:tcpCaptureLen], StartTime, EndTime, conn, cache)
+	require.NoError(t, err)
+	assert.True(t, more)
+	req, ok := cache.Peek(MongoRequestKey{connInfo: conn, requestID: 7})
+	require.True(t, ok)
+	require.Len(t, req.RequestSections, 2)
+	assert.True(t, req.RequestSections[1].Partial)
+	info, err := getMongoInfo(req)
+	require.NoError(t, err)
+	assert.Equal(t, "insert", info.OpName)
+	assert.Equal(t, "pyitems", info.Collection)
+	assert.Equal(t, "shop", info.DB)
+
+	// the same with no section bytes past the kind byte at all
+	cutAtKind := raw[:msgHeaderSize+int32Size+1+len(body)+1]
+	cache.Purge()
+	_, _, err = ProcessMongoEvent(cutAtKind, StartTime, EndTime, conn, cache)
+	require.NoError(t, err)
+}
