+// A reply cut after "ok: 0" but before the error's message is still a
+// failure, one that says why it has no details.
+func TestMongoErrorReplyCutAfterOk(t *testing.T) {
+	info, err := getMongoInfo(&MongoRequestValue{
+		RequestSections:  []mongoSection{{Type: sectionTypeBody, Body: bson.D{{Key: "find", Value: "items"}}}},
+		ResponseSections: []mongoSection{{Type: sectionTypeBody, Body: bson.D{{Key: "ok", Value: 0.0}}, Partial: true}},
+	})
+	require.NoError(t, err)
+	assert.False(t, info.Success)
+	span := TCPToMongoToSpan(&TCPRequestInfo{}, info)
+	assert.Equal(t, 1, span.Status)
+	assert.Empty(t, span.DBError.ErrorCode)
+	assert.Equal(t, "error reply cut before its message", span.DBError.Description)
+}
+
+// A reply that is not a body section is not a reply the parser understands.
+func TestMongoReplyWithSequenceSectionIsRejected(t *testing.T) {
+	_, err := getMongoInfo(&MongoRequestValue{
+		RequestSections:  []mongoSection{{Type: sectionTypeBody, Body: bson.D{{Key: "find", Value: "items"}}}},
+		ResponseSections: []mongoSection{{Type: sectionTypeDocumentSequence}},
