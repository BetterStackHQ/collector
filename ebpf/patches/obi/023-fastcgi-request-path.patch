+// cgiLength reads a FastCGI name-value length: one byte below 128, otherwise
+// four bytes big-endian with the top bit set (a long header such as a cookie).
+// It reports false when the bytes are not there.
+func cgiLength(b []byte) (int, []byte, bool) {
+	if len(b) == 0 {
+		return 0, b, false
+	}
+	if b[0]>>7 == 0 {
+		return int(b[0]), b[1:], true
+	}
+	if len(b) < 4 {
+		return 0, b, false
+	}
+	return int(binary.BigEndian.Uint32(b[:4]) & 0x7fffffff), b[4:], true
+}
