+func (p *Tracer) allowInjectionPID(pid app.PID) error {
+	if p.bpfObjects.InjectPids == nil {
+		return errors.New("injection PID map is not loaded")
+	}
+	if err := p.bpfObjects.InjectPids.Put(uint32(pid), uint8(1)); err != nil {
+		return err
+	}
+	if p.injectionPIDs == nil {
+		p.injectionPIDs = map[app.PID]struct{}{}
+	}
+	p.injectionPIDs[pid] = struct{}{}
+	return nil
+}
+
+func (p *Tracer) BlockPID(pid app.PID, _ uint32) {
+	p.iterMu.Lock()
+	defer p.iterMu.Unlock()
+	if _, ok := p.injectionPIDs[pid]; ok {
+		if err := p.bpfObjects.InjectPids.Delete(uint32(pid)); err != nil && !errors.Is(err, ebpf.ErrKeyNotExist) {
+			p.log.Warn("cannot revoke context propagation admission", "pid", pid, "error", err)
+			return
+		}
+		delete(p.injectionPIDs, pid)
+	}
+	p.seenPIDs.Remove(pid)
+}
 
