+++ b/pkg/appolly/discover/matcher_privileged_test.go
@@ -0,0 +1,71 @@
+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+//go:build linux && privileged_tests
+
+package discover
+
+import (
+	"context"
+	"log/slog"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/cilium/ebpf"
+	"github.com/cilium/ebpf/rlimit"
+	"github.com/stretchr/testify/require"
+
+	"go.opentelemetry.io/obi/pkg/appolly/app"
+	ebpfcommon "go.opentelemetry.io/obi/pkg/ebpf/common"
+	"go.opentelemetry.io/obi/pkg/pipe/msg"
+)
+
+func TestMatcherPublishesDeferredDenialsWithoutProcessEvents(t *testing.T) {
+	require.NoError(t, rlimit.RemoveMemlock())
+	eventContext := &ebpfcommon.EBPFEventContext{EBPFMaps: map[string]*ebpf.Map{}}
+	denied := ebpfcommon.NewDeniedPIDs(eventContext, slog.Default())
+	pid := app.PID(os.Getpid())
+	denied.Deny(pid) // Discovery precedes the first tracer's map creation.
+
+	input := make(chan []Event[ProcessAttrs])
+	m := &Matcher{
+		Log: slog.Default(), Denied: denied, Input: input,
+		Output: msg.NewQueue[[]Event[ProcessMatch]](),
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		m.Run(ctx)
+	}()
+	t.Cleanup(func() {
+		cancel()
+		<-done
+	})
+
+	deniedMap, err := ebpf.NewMap(&ebpf.MapSpec{
+		Type: ebpf.Hash, KeySize: 4, ValueSize: 1, MaxEntries: 16,
+	})
+	require.NoError(t, err)
+	defer deniedMap.Close()
+	eventContext.MapsLock.Lock()
+	eventContext.EBPFMaps["denied_pids"] = deniedMap
+	eventContext.MapsLock.Unlock()
+
+	// keyed by the pid as OBI's /proc reports it, like the allow bitmap
+	key := uint32(pid)
+	require.Eventually(t, func() bool {
+		var value uint8
+		return deniedMap.Lookup(key, &value) == nil && value == 1
+	}, 5*time.Second, 10*time.Millisecond)
+
+	// Closing input must also stop the retry ticker without context cancellation.
+	close(input)
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("matcher did not stop after input closed")
+	}
+}
