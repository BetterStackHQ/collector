diff --git a/bpf/tpinjector/discovery.h b/bpf/tpinjector/discovery.h
new file mode 100644
index 0000000..e44e2d9
--- /dev/null
+++ b/bpf/tpinjector/discovery.h
@@ -0,0 +1,36 @@
+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <pid/pid.h>
+#include <pid/pid_helpers.h>
+#include <pid/maps/denied_pids.h>
+#include <tpinjector/maps/inject_pids.h>
+
+// Pids are numbered as OBI's /proc numbers them (obi_pid(), bpf/pid/pid.h), the
+// same number userspace publishes into denied_pids and inject_pids.
+static __always_inline bool valid_inject_pid(u64 id) {
+    if (!filter_pids) {
+        return pid_from_pid_tgid(id) != 0;
+    }
+
+    const u32 pid = obi_pid(id);
+    if (!pid) {
+        return false;
+    }
+
+    // Check every send: cached admission must not outlive an explicit denial.
+    if (bpf_map_lookup_elem(&denied_pids, &pid)) {
+        return false;
+    }
+    if (bpf_map_lookup_elem(&inject_pids, &pid)) {
+        return true;
+    }
+
+    // Follow undiscovered workers. obi_parent_pid() numbers the parent in
+    // OBI's pid namespace too, and is 0 for a parent outside it, so a parent's
+    // number is never read in another namespace's numbering.
+    const u32 ppid = obi_parent_pid();
+    return ppid && bpf_map_lookup_elem(&inject_pids, &ppid) != NULL;
+}
