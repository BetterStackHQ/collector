+		pidProbe, err := ebpf.NewProgram(&ebpf.ProgramSpec{
+			Type: ebpf.SocketFilter, License: "GPL",
+			Instructions: asm.Instructions{asm.FnGetCurrentPidTgid.Call(), asm.RSh.Imm(asm.R0, 32), asm.Return()},
+		})
+		require.NoError(t, err)
+		defer pidProbe.Close()
+		pid, _, err = pidProbe.Test(make([]byte, 14))
+		require.NoError(t, err)
+	}
+
+	for _, route := range []string{"http_headers", "tcp_options", "go_grpc"} {
+		t.Run(route, func(t *testing.T) {
+			for _, policy := range []string{"rejected", "go_discovered", "generic_discovered", "blocked", "denied", "parent_allowed", "denied_child", "filter_off"} {
+				t.Run(policy, func(t *testing.T) {
+					filter := int32(1)
+					if policy == "filter_off" {
+						filter = 0
+					}
+					flags := uint32(1)
+					if route == "tcp_options" {
+						flags = 2
+					}
+					coll := loadPIDFilterInjector(t, filter, flags)
+					cfg := &obi.Config{}
+					injector := New(cfg)
+					injector.bpfObjects.InjectPids = coll.Maps["inject_pids"]
+					injector.backfillDisabled = true
+					userPID := app.PID(os.Getpid())
+					ns, err := procs.FindNamespace(userPID)
+					require.NoError(t, err)
+					fi := discexec.New(discexec.Init{Pid: userPID, Ns: ns})
+					rejected := policy == "rejected" || policy == "blocked" || policy == "denied" || policy == "denied_child"
+					if policy != "rejected" && policy != "filter_off" {
+						admitPID := userPID
+						if policy == "parent_allowed" || policy == "denied_child" {
+							admitPID = app.PID(os.Getppid())
+						}
+						// The common tracer receives these notifications for both Go
+						// and generic discovery, including before socket backfill.
+						if policy == "go_discovered" {
+							fi.ApplyServiceDefaults(svc.InstrumentableGolang)
+						} else {
+							fi.ApplyServiceDefaults(svc.InstrumentableGeneric)
+						}
+						injector.AllowPID(admitPID, ns, fi)
+						require.Contains(t, injector.injectionPIDs, admitPID)
+						if policy == "blocked" {
+							injector.BlockPID(userPID, ns)
+						}
+						if policy == "denied" || policy == "denied_child" {
+							// keyed like the matcher publishes it: the pid OBI's /proc reports
+							require.NoError(t, coll.Maps["denied_pids"].Put(uint32(userPID), uint8(1)))
+						}
+					}
+
+					client, server := injectorSocketPair(t)
+					local := client.LocalAddr().(*net.TCPAddr)
+					remote := client.RemoteAddr().(*net.TCPAddr)
+					conn := BpfConnectionInfoT{
+						S_addr: [16]byte(local.IP.To16()), D_addr: [16]byte(remote.IP.To16()),
+						S_port: uint16(local.Port), D_port: uint16(remote.Port),
+					}
+					// Both loopback ports are ephemeral: OBI sorts the larger first.
+					if conn.D_port > conn.S_port {
+						conn.S_port, conn.D_port = conn.D_port, conn.S_port
+						conn.S_addr, conn.D_addr = conn.D_addr, conn.S_addr
+					}
+					key := BpfEgressKeyT{S_port: conn.S_port, D_port: conn.D_port}
+					payload := []byte("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n")
+					if route == "go_grpc" {
+						key.StreamId = 1
+						require.NoError(t, coll.Maps["go_grpc_client_conns"].Put(
+							BpfPidConnectionInfoT{Conn: conn, Pid: pid}, uint8(1)))
+						payload = injectorGRPCRequest(t)
+					}
+					tp := BpfTpInfoPidT{Pid: pid, Valid: 1}
+					tp.Tp.TraceId[0], tp.Tp.SpanId[0], tp.Tp.Flags = 1, 2, 1
+					require.NoError(t, coll.Maps["outgoing_trace_map"].Put(key, tp))
+
+					raw, err := client.SyscallConn()
+					require.NoError(t, err)
+					var socketFD uint32
+					require.NoError(t, raw.Control(func(fd uintptr) {
+						socketFD = uint32(fd)
+						err = coll.Maps["sock_dir"].Put(uint64(1), socketFD)
+					}))
+					require.NoError(t, err)
+					require.NoError(t, client.SetWriteDeadline(time.Now().Add(5*time.Second)))
+					_, err = client.Write(payload)
+					require.NoError(t, err)
+					require.NoError(t, client.CloseWrite())
+					require.NoError(t, server.SetReadDeadline(time.Now().Add(5*time.Second)))
+					received, err := io.ReadAll(server)
+					require.NoError(t, err)
+
+					var scheduled BpfTpInfoPidT
+					err = coll.Maps["sk_tp_info_pid_map"].Lookup(socketFD, &scheduled)
+					if rejected {
+						assert.Equal(t, payload, received, "rejected PID must not get a header")
+						assert.ErrorIs(t, err, ebpf.ErrKeyNotExist, "rejected PID must not schedule a TCP option")
+						var pending BpfTpInfoPidT
+						require.NoError(t, coll.Maps["outgoing_trace_map"].Lookup(key, &pending))
+						assert.Equal(t, tp, pending, "rejected PID must not consume pending trace context")
+					} else if route == "tcp_options" {
+						require.NoError(t, err, "allowed PID must still schedule a TCP option")
+						assert.Equal(t, tp.Tp, scheduled.Tp)
+						assert.Equal(t, payload, received)
+					} else {
+						assert.Greater(t, len(received), len(payload), "allowed PID must still inject a header")
+						if route == "go_grpc" {
+							assertInjectedGRPCTraceparent(t, received)
+						} else {
+							assert.Contains(t, string(received), "Traceparent: 00-01000000000000000000000000000000-0200000000000000-01\r\n")
+						}
+					}
+				})
+			}
+		})
+	}
+}
+
+func loadPIDFilterInjector(t *testing.T, filter int32, flags uint32) *ebpf.Collection {
+	t.Helper()
+	spec, err := LoadBpf()
+	require.NoError(t, err)
+	require.NoError(t, spec.Variables["filter_pids"].Set(filter))
+	require.NoError(t, spec.Variables["inject_flags"].Set(flags))
+	// Number tasks the way production does (Tracer.constants), so the pids
+	// below match obi_pid() inside a container too.
+	for name, value := range ebpfcommon.PIDFilterConstants() {
+		require.NoError(t, spec.Variables[name].Set(value))
+	}
+	// Only attach to sockets created by this test; no cgroup-wide sockops probe.
+	for name, prog := range spec.Programs {
+		if prog.Type != ebpf.SkMsg && name != "obi_injector_tcp_connect" {
+			delete(spec.Programs, name)
+		}
+	}
+	for _, m := range spec.Maps {
+		m.Pinning = ebpf.PinNone
+	}
+	coll, err := ebpf.NewCollection(spec)
+	require.NoError(t, err)
+	t.Cleanup(coll.Close)
+	opts := link.RawAttachProgramOptions{
+		Target:  coll.Maps["sock_dir"].FD(),
+		Program: coll.Programs["obi_packet_extender"], Attach: ebpf.AttachSkMsgVerdict,
+	}
+	require.NoError(t, link.RawAttachProgram(opts))
+	t.Cleanup(func() { assert.NoError(t, link.RawDetachProgram(link.RawDetachProgramOptions(opts))) })
+	return coll
+}
+
+func injectorSocketPair(t *testing.T) (*net.TCPConn, net.Conn) {
+	t.Helper()
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = listener.Close() })
+	client, err := net.Dial("tcp4", listener.Addr().String())
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = client.Close() })
+	server, err := listener.Accept()
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = server.Close() })
+	return client.(*net.TCPConn), server
+}
+
+func injectorGRPCRequest(t *testing.T) []byte {
+	t.Helper()
+	var headers bytes.Buffer
+	enc := hpack.NewEncoder(&headers)
+	for _, field := range []hpack.HeaderField{
+		{Name: ":method", Value: "POST"}, {Name: ":scheme", Value: "http"},
+		{Name: ":path", Value: "/test.Service/Call"}, {Name: ":authority", Value: "localhost"},
+		{Name: "content-type", Value: "application/grpc"},
+	} {
+		require.NoError(t, enc.WriteField(field))
+	}
+	var wire bytes.Buffer
+	wire.WriteString(http2.ClientPreface)
+	framer := http2.NewFramer(&wire, nil)
+	require.NoError(t, framer.WriteSettings())
+	require.NoError(t, framer.WriteHeaders(http2.HeadersFrameParam{
+		StreamID: 1, BlockFragment: headers.Bytes(), EndHeaders: true, EndStream: true,
+	}))
+	return wire.Bytes()
+}
+
+func assertInjectedGRPCTraceparent(t *testing.T, wire []byte) {
+	t.Helper()
+	require.True(t, bytes.HasPrefix(wire, []byte(http2.ClientPreface)))
+	framer := http2.NewFramer(nil, bytes.NewReader(wire[len(http2.ClientPreface):]))
+	_, err := framer.ReadFrame()
+	require.NoError(t, err)
+	frame, err := framer.ReadFrame()
+	require.NoError(t, err)
+	headers, ok := frame.(*http2.HeadersFrame)
+	require.True(t, ok)
+	fields, err := hpack.NewDecoder(4096, nil).DecodeFull(headers.HeaderBlockFragment())
+	require.NoError(t, err)
+	assert.Contains(t, fields, hpack.HeaderField{
+		Name: "traceparent", Value: "00-01000000000000000000000000000000-0200000000000000-01",
+	})
+}
