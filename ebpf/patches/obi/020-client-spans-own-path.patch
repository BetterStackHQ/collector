+// The Host header's port is kept apart from the host: url.full needs it, while
+// server.address and name resolution keep seeing the bare host.
+func TestHTTPRequestToSpanKeepsHostHeaderPort(t *testing.T) {
+	newClientEvent := func(buf string) *BPFHTTPInfo {
+		event := makeBPFInfoWithBuf([]uint8(buf))
+		event.Type = uint8(request.EventTypeHTTPClient)
+		event.ConnInfo.S_port = 34567
+		event.ConnInfo.D_port = 4000
+		return &event
+	}
+
+	t.Run("port named by the header", func(t *testing.T) {
+		event := newClientEvent("POST /reserve HTTP/1.1\r\nHost: inventory:4000\r\n\r\n")
+		span := httpRequestToSpan(event, largebuf.NewLargeBufferFrom(event.Buf[:]))
+		assert.Equal(t, "http;inventory", span.Statement)
+		assert.Equal(t, 4000, span.HostHeaderPort)
+		assert.Equal(t, 4000, span.HostPort)
+	})
+
+	t.Run("no port in the header", func(t *testing.T) {
+		event := newClientEvent("POST /reserve HTTP/1.1\r\nHost: inventory\r\n\r\n")
+		span := httpRequestToSpan(event, largebuf.NewLargeBufferFrom(event.Buf[:]))
+		assert.Equal(t, "http;inventory", span.Statement)
+		assert.Equal(t, 0, span.HostHeaderPort)
+	})
+
+	t.Run("ipv6 literal", func(t *testing.T) {
+		event := newClientEvent("GET /stock/3 HTTP/1.1\r\nHost: [2001:db8::1]:8080\r\n\r\n")
+		span := httpRequestToSpan(event, largebuf.NewLargeBufferFrom(event.Buf[:]))
+		assert.Equal(t, "http;2001:db8::1", span.Statement)
+		assert.Equal(t, 8080, span.HostHeaderPort)
+	})
+
+	t.Run("a port outside the TCP range is not a port", func(t *testing.T) {
+		event := newClientEvent("POST /reserve HTTP/1.1\r\nHost: inventory:70000\r\n\r\n")
+		span := httpRequestToSpan(event, largebuf.NewLargeBufferFrom(event.Buf[:]))
+		assert.Equal(t, "http;inventory", span.Statement)
+		assert.Equal(t, 0, span.HostHeaderPort)
+	})
+
+	t.Run("payload parser falls back to the buffer for an empty Host", func(t *testing.T) {
+		event := newClientEvent("POST /reserve HTTP/1.1\r\nHost: inventory:4000\r\n\r\n")
+		req := &http.Request{Method: http.MethodPost, URL: &url.URL{Path: "/reserve"}, Body: io.NopCloser(strings.NewReader(""))}
+		resp := &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(bytes.NewReader(nil))}
+		span := httpRequestResponseToSpan(nil, event, req, resp)
+		assert.Equal(t, "http;inventory", span.Statement)
+		assert.Equal(t, 4000, span.HostHeaderPort)
+	})
+
+	t.Run("no connection info takes host and port from the header", func(t *testing.T) {
+		event := newClientEvent("POST /reserve HTTP/1.1\r\nHost: inventory:4000\r\n\r\n")
+		event.ConnInfo.S_port, event.ConnInfo.D_port = 0, 0
+		span := httpRequestToSpan(event, largebuf.NewLargeBufferFrom(event.Buf[:]))
+		assert.Equal(t, "inventory", span.Host)
+		assert.Equal(t, 4000, span.HostPort)
+		assert.Equal(t, 4000, span.HostHeaderPort)
+		assert.Equal(t, "http;inventory", span.Statement)
+	})
+}
