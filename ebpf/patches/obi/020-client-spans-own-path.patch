+func TestRouteHasLiteralSegment(t *testing.T) {
+	for route, want := range map[string]bool{
+		"/<path:url>":       false,
+		"/{slug}":           false,
+		"/:path*":           false,
+		"/*":                false,
+		"/":                 false,
+		"/users/{id}":       true,
+		"/api/<path:rest>":  true,
+		"/{tenant}/orders":  true,
+		"/@:username/posts": true,
+		"/orders":           true,
+	} {
+		assert.Equal(t, want, routeHasLiteralSegment(route), route)
+	}
+}
