+// hostNamesPort reports whether a host string already carries a port. A bare
+// IPv6 literal, which the header parser hands over without its brackets, does
+// not, however many colons it has.
+func hostNamesPort(host string) bool {
+	if net.ParseIP(strings.Trim(host, "[]")) != nil {
+		return strings.HasPrefix(host, "[") && strings.LastIndexByte(host, ':') > strings.LastIndexByte(host, ']')
+	}
+	return strings.IndexByte(host, ':') >= 0
+}
+
+// HTTPClientAuthority is what url.full names as the authority: the Host header
+// as the client sent it, port included, or the resolved server when the
+// request carried no header. The port is the header's, never the
+// connection's: through a forward proxy or a socket-level load balancer the
+// connection's port is not the URL's.
+func HTTPClientAuthority(span *Span) string {
+	host := HTTPClientHost(span)
+	if span.HostHeaderPort <= 0 || host == "" || hostNamesPort(host) {
+		return host
+	}
+	return net.JoinHostPort(strings.Trim(host, "[]"), strconv.Itoa(span.HostHeaderPort))
+}
