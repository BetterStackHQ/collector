+					{Type: request.EventTypeHTTP, Method: "GET", Path: "/api/orders/7", Service: service},
+					{Type: request.EventTypeHTTPClient, Method: "GET", Path: "/api/orders/7", Service: service},
+				})
+				spans := testutil.ReadChannel(t, out, testTimeout)
+				require.Len(t, spans, 7)
+				assert.Equal(t, "/orders", spans[0].Route)
+				assert.Equal(t, "/<path:url>", spans[1].Route, "incoming requests are named by the harvested routes")
+				assert.Equal(t, "/reserve", spans[2].Route, "an outgoing call keeps its own path")
+				assert.Equal(t, "/stock/*", spans[3].Route, "or its heuristic clustering")
+				assert.Equal(t, "/users/{id}", spans[4].Route, "a harvested route with a literal segment still names a call")
+				assert.Equal(t, "/api/<path:rest>", spans[5].Route, "a prefixed catch-all names incoming requests")
+				assert.Equal(t, "/api/orders/*", spans[6].Route, "but not the calls a gateway forwards")
+			})
+		}
+	}
+}
