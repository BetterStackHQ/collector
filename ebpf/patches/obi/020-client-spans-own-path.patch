+// harvestedRoute names a span from the routes harvested out of the process's
+// source. Those are mostly the process's own endpoints, which say nothing
+// about the paths it calls on other services, but some describe outgoing
+// calls too (a Spring Feign client's annotated interface), so a client span
+// may still take a harvested route: just not a catch-all. A pattern without a
+// single literal segment, Django's <path:url> or a bare /{slug}, matches any
+// path at all, and applied to outgoing calls it named every one of them the
+// same. Such a pattern names incoming requests only.
+func harvestedRoute(span *request.Span) string {
+	pattern := span.Service.HarvestedRouteMatcher.Find(span.Path)
+	if pattern == "" || !span.IsClientSpan() {
+		return pattern
+	}
+	// A harvested route mostly describes a request the process serves. One
+	// without a literal segment, or with a catch-all segment, matches any
+	// outgoing call and says nothing about it; a Feign-style /users/{id}
+	// still names the call it describes.
+	if routeHasLiteralSegment(pattern) && !route.HasCatchAll(pattern) {
+		return pattern
+	}
+	return ""
+}
+
+// routeHasLiteralSegment reports whether a route pattern pins at least one
+// path segment to a fixed value rather than a placeholder.
+func routeHasLiteralSegment(route string) bool {
+	for _, segment := range strings.Split(route, "/") {
+		if segment == "" {
+			continue
+		}
+		switch segment[0] {
+		case '{', '<', ':', '*':
+			continue
+		}
+		return true
+	}
+	return false
+}
