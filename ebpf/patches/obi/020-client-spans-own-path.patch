@@ -0,0 +1,51 @@
+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package tracesgen
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"go.opentelemetry.io/obi/pkg/appolly/app/request"
+	attr "go.opentelemetry.io/obi/pkg/export/attributes/names"
+)
+
+// url.full carries the authority the client put in its Host header, port
+// included: a call to inventory:4000 is http://inventory:4000/reserve. The
+// connection's port is never consulted; through a forward proxy or a
+// socket-level load balancer it is not the URL's port.
+func TestTraceAttributesSelector_URLFullAuthority(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		statement  string
+		headerPort int
+		connPort   int
+		want       string
+	}{
+		{"port named by the header", "http;inventory", 4000, 4000, "http://inventory:4000/reserve"},
+		{"no port in the header", "http;inventory", 0, 4000, "http://inventory/reserve"},
+		{"header kept whole by the payload parser", "http;inventory:4000", 0, 4000, "http://inventory:4000/reserve"},
+		{"default port spelled out", "http;inventory", 80, 80, "http://inventory:80/reserve"},
+		{"https", "https;inventory", 8443, 8443, "https://inventory:8443/reserve"},
+		{"ipv6 literal with port", "http;2001:db8::1", 8080, 8080, "http://[2001:db8::1]:8080/reserve"},
+		{"ipv6 literal", "http;[2001:db8::1]", 0, 8080, "http://[2001:db8::1]/reserve"},
+		// a CONNECT tunnel: the header names the origin, the connection a proxy
+		{"forward proxy", "https;api.example.com", 0, 3128, "https://api.example.com/reserve"},
+		{"socket-level load balancing", "http;inventory", 0, 8080, "http://inventory/reserve"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			span := &request.Span{
+				Type: request.EventTypeHTTPClient, Method: "POST", Path: "/reserve",
+				Host: "10.0.0.5", HostPort: tc.connPort, HostHeaderPort: tc.headerPort, Status: 200,
+				Statement: tc.statement,
+			}
+			selected := AttrsToMap(TraceAttributesSelector(span, map[attr.Name]struct{}{}))
+			val, ok := selected.Get("url.full")
+			require.True(t, ok, tc.want)
+			assert.Equal(t, tc.want, val.Str())
+		})
+	}
+}
