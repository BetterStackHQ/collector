+// postgresControlStatements are the statements drivers run through the same
+// paths as queries without there being a query in them: transaction control
+// and session setup. pgjdbc turns them into named prepared statements after a
+// few runs and pipelines BEGIN with the first statement of a transaction into
+// one write; PDO prepares `set names` first on every connection.
+var postgresControlStatements = map[string]struct{}{
+	"BEGIN": {}, "START": {}, "COMMIT": {}, "END": {}, "ROLLBACK": {}, "ABORT": {},
+	"SAVEPOINT": {}, "RELEASE": {}, "SET": {}, "RESET": {}, "DEALLOCATE": {}, "DISCARD": {},
+}
+
+// postgresControlStatement returns the leading keyword of text, upper-cased,
+// when it is one of postgresControlStatements, and "" otherwise.
+func postgresControlStatement(text []byte) string {
+	i := 0
+	for i < len(text) && (text[i] == ' ' || text[i] == '\t' || text[i] == '\n' || text[i] == '\r' || text[i] == '(') {
+		i++
+	}
+	j := i
+	for j < len(text) && ((text[j] >= 'a' && text[j] <= 'z') || (text[j] >= 'A' && text[j] <= 'Z')) {
+		j++
+	}
+	if j == i || j > i+10 {
+		return ""
+	}
+	word := strings.ToUpper(string(text[i:j]))
+	if _, ok := postgresControlStatements[word]; ok {
+		return word
+	}
+	return ""
+}
