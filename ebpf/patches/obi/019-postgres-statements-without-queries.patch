+// PDO prepares `set names` first on every connection, so it was the
+// `PREPARED STATEMENT .pdo_stmt_00000001` span on every request.
+func TestHandlePostgresPDOSetNames(t *testing.T) {
+	ctx := newPostgresTestContext()
+	event := &TCPRequestInfo{}
+
+	parse := postgresWrite(
+		postgresTestPacket(kPostgresParse, postgresParseTestBody("pdo_stmt_00000001", "set names 'utf8'")),
+		postgresTestPacket('S', nil))
+	_, err := handlePostgres(ctx, event, largebuf.NewLargeBufferFrom(parse), largebuf.NewLargeBufferFrom(postgresTestPacket('1', nil)))
+	require.ErrorIs(t, err, errIgnore)
+
+	execute := postgresWrite(
+		postgresTestPacket(kPostgresBind, postgresBindTestBody("", "pdo_stmt_00000001")),
+		postgresTestPacket('D', []byte{'P', 0}),
+		postgresTestPacket('E', postgresExecuteTestBody("")),
+		postgresTestPacket('S', nil))
+	_, err = handlePostgres(ctx, event, largebuf.NewLargeBufferFrom(execute), largebuf.NewLargeBufferFrom(postgresExtendedResponse("")))
+	require.ErrorIs(t, err, errIgnore)
+
+	// the real query after it is still a span
+	parse = postgresWrite(
+		postgresTestPacket(kPostgresParse, postgresParseTestBody("pdo_stmt_00000002", "SELECT * FROM books WHERE id = $1")),
+		postgresTestPacket('S', nil))
+	_, err = handlePostgres(ctx, event, largebuf.NewLargeBufferFrom(parse), largebuf.NewLargeBufferFrom(postgresTestPacket('1', nil)))
+	require.ErrorIs(t, err, errIgnore)
+	execute = postgresWrite(
+		postgresTestPacket(kPostgresBind, postgresBindTestBody("", "pdo_stmt_00000002", "7")),
+		postgresTestPacket('D', []byte{'P', 0}),
+		postgresTestPacket('E', postgresExecuteTestBody("")),
+		postgresTestPacket('S', nil))
+	span, err := handlePostgres(ctx, event, largebuf.NewLargeBufferFrom(execute), largebuf.NewLargeBufferFrom(postgresExtendedResponse("D")))
+	require.NoError(t, err)
+	assert.Equal(t, "SELECT", span.Method)
+	assert.Equal(t, "books", span.Path)
+}
