+// --- statements without a query in them -------------------------------------
+
+func postgresBindTestBody(portal, statement string, args ...string) []byte {
+	body := append([]byte(portal), 0)
+	body = append(body, statement...)
+	body = append(body, 0)
+	body = binary.BigEndian.AppendUint16(body, 0) // parameter format codes: all text
+	body = binary.BigEndian.AppendUint16(body, uint16(len(args)))
+	for _, arg := range args {
+		body = binary.BigEndian.AppendUint32(body, uint32(len(arg)))
+		body = append(body, arg...)
+	}
+	body = binary.BigEndian.AppendUint16(body, 0) // result format codes
+	return body
+}
+
+func postgresExecuteTestBody(portal string) []byte {
+	body := append([]byte(portal), 0)
+	return binary.BigEndian.AppendUint32(body, 0)
+}
+
+// postgresWrite concatenates frontend messages the way a driver pipelines them
+// into one send.
+func postgresWrite(packets ...[]byte) []byte {
+	var out []byte
+	for _, p := range packets {
+		out = append(out, p...)
+	}
+	return out
+}
+
+func postgresExtendedResponse(perStatement ...string) []byte {
+	// each statement answers BindComplete (+ rows) + CommandComplete; then ReadyForQuery
+	var out []byte
+	for _, rows := range perStatement {
+		out = append(out, postgresTestPacket('2', nil)...)
+		for range len(rows) {
+			out = append(out, postgresTestPacket('D', []byte{0, 1, 0, 0, 0, 1, '1'})...)
+		}
+		out = append(out, postgresTestPacket('C', []byte("SELECT 1\x00"))...)
+	}
+	return append(out, postgresTestPacket('Z', []byte{'I'})...)
+}
+
+// pgjdbc names BEGIN like any other statement once it has run a few times and
+// pipelines it with the first statement of the transaction. The write used to
+// end as a `PREPARED STATEMENT` span with no SQL, with the query behind BEGIN
+// lost.
+func TestHandlePostgresPipelinedBeginAndQuery(t *testing.T) {
+	ctx := newPostgresTestContext()
+	event := &TCPRequestInfo{}
+
+	// the Parse messages of both named statements, as pgjdbc sends them on the sixth run
+	for _, prepare := range []struct{ name, sql string }{
+		{"S_2", "BEGIN"},
+		{"S_3", "SELECT * FROM books WHERE id = $1 FOR UPDATE"},
+	} {
+		write := postgresWrite(
+			postgresTestPacket(kPostgresParse, postgresParseTestBody(prepare.name, prepare.sql)),
+			postgresTestPacket(kPostgresBind, postgresBindTestBody("", prepare.name)),
+			postgresTestPacket('E', postgresExecuteTestBody("")),
+			postgresTestPacket('S', nil))
+		_, _ = handlePostgres(ctx, event, largebuf.NewLargeBufferFrom(write), largebuf.NewLargeBufferFrom(postgresExtendedResponse("")))
+	}
+
+	write := postgresWrite(
+		postgresTestPacket(kPostgresBind, postgresBindTestBody("", "S_2")),
+		postgresTestPacket('E', postgresExecuteTestBody("")),
+		postgresTestPacket(kPostgresBind, postgresBindTestBody("", "S_3", "7")),
+		postgresTestPacket('E', postgresExecuteTestBody("")),
+		postgresTestPacket('S', nil))
+	span, err := handlePostgres(ctx, event, largebuf.NewLargeBufferFrom(write), largebuf.NewLargeBufferFrom(postgresExtendedResponse("", "D")))
+	require.NoError(t, err)
+	assert.Equal(t, "SELECT", span.Method)
+	assert.Equal(t, "books", span.Path)
+	assert.Equal(t, "SELECT * FROM books WHERE id = $1 FOR UPDATE", span.Statement)
+}
+
+// A write that executes only BEGIN or COMMIT is not a span.
+func TestHandlePostgresTransactionControlOnly(t *testing.T) {
+	ctx := newPostgresTestContext()
+	event := &TCPRequestInfo{}
+
+	parse := postgresWrite(
+		postgresTestPacket(kPostgresParse, postgresParseTestBody("S_1", "COMMIT")),
+		postgresTestPacket('S', nil))
+	_, err := handlePostgres(ctx, event, largebuf.NewLargeBufferFrom(parse), largebuf.NewLargeBufferFrom(postgresTestPacket('1', nil)))
+	require.ErrorIs(t, err, errIgnore)
+
+	commit := postgresWrite(
+		postgresTestPacket(kPostgresBind, postgresBindTestBody("", "S_1")),
+		postgresTestPacket('E', postgresExecuteTestBody("")),
+		postgresTestPacket('S', nil))
+	_, err = handlePostgres(ctx, event, largebuf.NewLargeBufferFrom(commit), largebuf.NewLargeBufferFrom(postgresExtendedResponse("")))
+	require.ErrorIs(t, err, errIgnore, "no span, and no fallback to the generic naming either")
+
+	for _, simple := range []string{"BEGIN", "COMMIT", "DEALLOCATE pdo_stmt_00000001", "SET search_path TO public"} {
+		query := postgresTestPacket(kPostgresQuery, append([]byte(simple), 0))
+		_, err := handlePostgres(ctx, event, largebuf.NewLargeBufferFrom(query), largebuf.NewLargeBufferFrom(postgresTestPacket('C', []byte("x\x00"))))
+		require.ErrorIs(t, err, errIgnore, simple)
+	}
+
+	// EXECUTE <name> as a simple query keeps its generic naming
+	execute := postgresTestPacket(kPostgresQuery, []byte("EXECUTE fetch_books(1)\x00"))
+	_, err = handlePostgres(ctx, event, largebuf.NewLargeBufferFrom(execute), largebuf.NewLargeBufferFrom(postgresTestPacket('C', []byte("x\x00"))))
+	require.ErrorIs(t, err, errFallback)
+}
