+// A COMMIT that fails is the only place a serialization failure shows up.
+func TestHandlePostgresFailedCommitIsASpan(t *testing.T) {
+	ctx := newPostgresTestContext()
+	event := &TCPRequestInfo{}
+	parse := postgresWrite(
+		postgresTestPacket(kPostgresParse, postgresParseTestBody("S_1", "COMMIT")),
+		postgresTestPacket('S', nil))
+	_, err := handlePostgres(ctx, event, largebuf.NewLargeBufferFrom(parse), largebuf.NewLargeBufferFrom(postgresTestPacket('1', nil)))
+	require.ErrorIs(t, err, errIgnore)
+
+	commit := postgresWrite(
+		postgresTestPacket(kPostgresBind, postgresBindTestBody("", "S_1")),
+		postgresTestPacket('E', postgresExecuteTestBody("")),
+		postgresTestPacket('S', nil))
+	failed := postgresWrite(
+		postgresTestPacket('2', nil),
+		postgresErrorResponse("40001", "could not serialize access due to concurrent update"),
+		postgresTestPacket('Z', []byte{'I'}))
+	span, err := handlePostgres(ctx, event, largebuf.NewLargeBufferFrom(commit), largebuf.NewLargeBufferFrom(failed))
+	require.NoError(t, err)
+	assert.Equal(t, "COMMIT", span.Method)
+	assert.Equal(t, 1, span.Status)
+	require.NotNil(t, span.SQLError)
+	assert.Equal(t, "40001", span.SQLError.SQLState)
+
+	// a successful COMMIT stays silent
+	_, err = handlePostgres(ctx, event, largebuf.NewLargeBufferFrom(commit), largebuf.NewLargeBufferFrom(postgresExtendedResponse("")))
+	require.ErrorIs(t, err, errIgnore)
+
+	// so does a simple BEGIN that fails (there is nothing to report but its text)
+	begin := postgresTestPacket(kPostgresQuery, []byte("COMMIT\x00"))
+	span, err = handlePostgres(ctx, event, largebuf.NewLargeBufferFrom(begin), largebuf.NewLargeBufferFrom(postgresWrite(postgresErrorResponse("40001", "serialization"), postgresTestPacket('Z', []byte{'I'}))))
+	require.NoError(t, err)
+	assert.Equal(t, "COMMIT", span.Method)
+	assert.Equal(t, "COMMIT", span.Statement)
+}
