+func TestPostgresControlStatement(t *testing.T) {
+	for text, want := range map[string]string{
+		"BEGIN":                     "BEGIN",
+		"begin work":                "BEGIN",
+		"  COMMIT":                  "COMMIT",
+		"START TRANSACTION":         "START",
+		"set names 'utf8'":          "SET",
+		"SET search_path TO public": "SET",
+		"RESET ALL":                 "RESET",
+		"DEALLOCATE pdo_stmt_1":     "DEALLOCATE",
+		"DISCARD ALL":               "DISCARD",
+		"ROLLBACK TO SAVEPOINT a":   "ROLLBACK",
+		"SELECT 1":                  "",
+		"CALL refresh_stats($1)":    "",
+		"TRUNCATE orders":           "",
+		"settings":                  "",
+		"":                          "",
+	} {
+		assert.Equal(t, want, postgresControlStatement([]byte(text)), text)
+	}
+}
