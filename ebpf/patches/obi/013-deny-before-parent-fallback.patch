diff --git a/bpf/pid/maps/denied_pids.h b/bpf/pid/maps/denied_pids.h
new file mode 100644
index 0000000..72ab8c5
--- /dev/null
+++ b/bpf/pid/maps/denied_pids.h
@@ -0,0 +1,33 @@
+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <bpfcore/vmlinux.h>
+#include <bpfcore/bpf_helpers.h>
+
+#include <common/pin_internal.h>
+
+#include <pid/maps/map_sizing.h>
+
+// Processes discovery excluded, keyed exactly like the allow bitmap that
+// pid_selected() reads: the pid as OBI's /proc numbers it, which is what
+// obi_pid() derives for the current task. Filled from userspace by the
+// criteria matcher, which is the only component that evaluates
+// exclude_instrument and the only one that sees the processes it drops.
+//
+// An exact-match hash rather than a second bitmap: the allow side can afford
+// a dense array because every pid has its own bit, but a deny set is small and
+// sparse, and a hash keeps a stale or colliding entry from ever denying a
+// process the user did select.
+//
+// Sized by k_max_concurrent_pids (3001 entries, one per excluded process). A
+// full map means new denials are refused, which userspace reports; it does not
+// evict, so an existing denial can never quietly lapse.
+struct {
+    __uint(type, BPF_MAP_TYPE_HASH);
+    __uint(max_entries, k_max_concurrent_pids);
+    __type(key, u32);
+    __type(value, u8);
+    __uint(pinning, OBI_PIN_INTERNAL);
+} denied_pids SEC(".maps");
