+
+// dalli, pymemcache and spymemcached speak memcached's binary protocol, which
+// Couchbase inherited. A connection with none of Couchbase's negotiation, on a
+// port other than Couchbase's KV ports, is memcached: the spans say so, take the
+// server or client kind from the direction like the text protocol does, and a
+// miss is a normal result rather than an error.
+func TestBinaryProtocolMemcachedWithoutCouchbaseTraits(t *testing.T) {
+	cache, err := simplelru.NewLRU[BpfConnectionInfoT, CouchbaseBucketInfo](16, nil)
+	require.NoError(t, err)
+	conn := newTestConnInfo()
+	conn.D_port = 11211
+
+	req := makeCouchbaseRequestPacket(couchbasekv.OpcodeGet, "views/books/7", "", nil)
+	miss := makeCouchbaseResponsePacket(couchbasekv.OpcodeGet, couchbasekv.StatusKeyNotFound, "")
+	info, ignore, err := processCouchbaseEvent(conn, req, miss, cache)
+	require.NoError(t, err)
+	require.False(t, ignore)
+	require.NotNil(t, info)
+	assert.True(t, info.Memcached)
+	assert.Equal(t, couchbasekv.StatusKeyNotFound, info.Status)
+	assert.False(t, info.IsError, "a miss is how a cache says no")
+
+	event := &TCPRequestInfo{ConnInfo: conn, Direction: directionSend}
+	span := TCPToCouchbaseToSpan(event, info)
+	assert.Equal(t, request.EventTypeMemcachedClient, span.Type)
+	assert.Equal(t, "GET", span.Method)
+	assert.Equal(t, "views/books/7", span.Path, "the key is the path, as for the text protocol")
+	assert.Equal(t, 0, span.Status)
+	assert.Empty(t, span.DBNamespace)
+
+	event.Direction = directionRecv
+	assert.Equal(t, request.EventTypeMemcachedServer, TCPToCouchbaseToSpan(event, info).Type, "the memcached process itself is the server")
+
+	// a real failure still is one
+	tooLarge := makeCouchbaseResponsePacket(couchbasekv.OpcodeSet, couchbasekv.StatusValueTooLarge, "")
+	set := makeCouchbaseRequestPacket(couchbasekv.OpcodeSet, "views/books/7", "<li>", []byte{0, 0, 0, 0, 0, 0, 1, 44})
+	info, _, err = processCouchbaseEvent(conn, set, tooLarge, cache)
+	require.NoError(t, err)
+	assert.True(t, info.Memcached)
+	assert.True(t, info.IsError)
+	assert.Equal(t, int(couchbasekv.StatusValueTooLarge), TCPToCouchbaseToSpan(event, info).Status)
+}
+
+// A Couchbase SDK negotiates before its first KV operation; once a connection has
+// shown that, it stays Couchbase, with Couchbase's error semantics, whatever port.
+func TestBinaryProtocolCouchbaseAfterNegotiation(t *testing.T) {
+	cache, err := simplelru.NewLRU[BpfConnectionInfoT, CouchbaseBucketInfo](16, nil)
+	require.NoError(t, err)
+	conn := newTestConnInfo()
+	conn.D_port = 12000
+
+	hello := makeCouchbaseRequestPacket(couchbasekv.OpcodeHello, "{\"a\":\"sdk\"}", "", nil)
+	_, ignore, err := processCouchbaseEvent(conn, hello, nil, cache)
+	require.NoError(t, err)
+	assert.True(t, ignore, "HELLO is not a span")
+
+	req := makeCouchbaseRequestPacket(couchbasekv.OpcodeGet, "doc::1", "", nil)
+	miss := makeCouchbaseResponsePacket(couchbasekv.OpcodeGet, couchbasekv.StatusKeyNotFound, "")
+	info, ignore, err := processCouchbaseEvent(conn, req, miss, cache)
+	require.NoError(t, err)
+	require.False(t, ignore)
+	assert.False(t, info.Memcached)
+	assert.True(t, info.IsError, "Couchbase semantics are unchanged")
+	assert.Equal(t, request.EventTypeCouchbaseClient, TCPToCouchbaseToSpan(&TCPRequestInfo{ConnInfo: conn, Direction: directionSend}, info).Type)
+
+	// another connection to the same port has not negotiated and is memcached
+	other := conn
+	other.S_port = 54399
+	info, _, err = processCouchbaseEvent(other, req, miss, cache)
+	require.NoError(t, err)
+	assert.True(t, info.Memcached)
+}
+
+// Couchbase's KV ports settle it even when the negotiation happened before the
+// connection was watched.
+func TestBinaryProtocolCouchbaseByPort(t *testing.T) {
+	for _, port := range []uint16{11210, 11207} {
+		conn := newTestConnInfo()
+		conn.D_port = port
+		req := makeCouchbaseRequestPacket(couchbasekv.OpcodeGet, "doc::1", "", nil)
+		info, _, err := processCouchbaseEvent(conn, req, nil, nil)
+		require.NoError(t, err)
+		assert.False(t, info.Memcached, "port %d", port)
+	}
+}
+
+// SELECT_BUCKET marks the connection as Couchbase as well as recording the bucket.
+func TestBinaryProtocolSelectBucketMarksCouchbase(t *testing.T) {
+	cache, err := simplelru.NewLRU[BpfConnectionInfoT, CouchbaseBucketInfo](16, nil)
+	require.NoError(t, err)
+	conn := newTestConnInfo()
+	conn.D_port = 12000
+	sel := makeCouchbaseRequestPacket(couchbasekv.OpcodeSelectBucket, "travel-sample", "", nil)
+	ok := makeCouchbaseResponsePacket(couchbasekv.OpcodeSelectBucket, couchbasekv.StatusSuccess, "")
+	_, _, err = processCouchbaseEvent(conn, sel, ok, cache)
+	require.NoError(t, err)
+	bucket, found := cache.Get(conn)
+	require.True(t, found)
+	assert.True(t, bucket.Couchbase)
+	assert.Equal(t, "travel-sample", bucket.Bucket)
+}
+
+// memcached speaks SASL too (`memcached -S`; dalli and spymemcached with
+// credentials), so authenticating does not make a connection Couchbase.
+func TestBinaryProtocolSASLIsNotCouchbase(t *testing.T) {
+	cache, err := simplelru.NewLRU[BpfConnectionInfoT, CouchbaseBucketInfo](16, nil)
+	require.NoError(t, err)
+	conn := newTestConnInfo()
+	conn.D_port = 11211
+	mechs := makeCouchbaseRequestPacket(couchbasekv.OpcodeSASLListMechs, "", "", nil)
+	_, _, err = processCouchbaseEvent(conn, mechs, nil, cache)
+	require.NoError(t, err)
+	auth := makeCouchbaseRequestPacket(couchbasekv.OpcodeSASLAuth, "PLAIN", "\x00user\x00secret", nil)
+	_, _, err = processCouchbaseEvent(conn, auth, nil, cache)
+	require.NoError(t, err)
+
+	req := makeCouchbaseRequestPacket(couchbasekv.OpcodeGet, "k", "", nil)
+	info, _, err := processCouchbaseEvent(conn, req, nil, cache)
+	require.NoError(t, err)
+	assert.True(t, info.Memcached)
+}
+
+// ADD on an existing key and a failed conditional store are normal answers on a
+// cache, as the text protocol's EXISTS and NOT_STORED are; raw bytes in a key
+// do not make the span invalid.
+func TestBinaryProtocolMemcachedConditionalOutcomes(t *testing.T) {
+	conn := newTestConnInfo()
+	conn.D_port = 11211
+	for _, tc := range []struct {
+		op     couchbasekv.Opcode
+		status couchbasekv.Status
+	}{
+		{couchbasekv.OpcodeAdd, couchbasekv.StatusKeyExists},
+		{couchbasekv.OpcodeReplace, couchbasekv.StatusItemNotStored},
+	} {
+		req := makeCouchbaseRequestPacket(tc.op, "lock:1", "1", []byte{0, 0, 0, 0, 0, 0, 0, 60})
+		resp := makeCouchbaseResponsePacket(tc.op, tc.status, "")
+		info, _, err := processCouchbaseEvent(conn, req, resp, nil)
+		require.NoError(t, err)
+		assert.False(t, info.IsError, "%s with %s", tc.op, tc.status)
+	}
+
+	req := makeCouchbaseRequestPacket(couchbasekv.OpcodeGet, "digest:\xff\xfe", "", nil)
+	info, _, err := processCouchbaseEvent(conn, req, nil, nil)
+	require.NoError(t, err)
+	span := TCPToCouchbaseToSpan(&TCPRequestInfo{ConnInfo: conn, Direction: directionSend}, info)
+	assert.Equal(t, "digest:", span.Path)
+	assert.True(t, span.IsValid())
+}
