diff --git a/pkg/ebpf/common/couchbase_detect_transform.go b/pkg/ebpf/common/couchbase_detect_transform.go
index 40e4f9221..2aff31910 100644
--- a/pkg/ebpf/common/couchbase_detect_transform.go
+++ b/pkg/ebpf/common/couchbase_detect_transform.go
@@ -30,6 +30,80 @@ type CouchbaseInfo struct {
 	Statement  string
 	Status     couchbasekv.Status
 	IsError    bool
+	// Memcached is set when the connection is a plain memcached one rather than
+	// Couchbase; the two share the binary protocol.
+	Memcached bool
+}
+
+// Couchbase's KV service listens on these ports (plain, TLS, and the node-local
+// one its own services use); memcached's own is 11211.
+const (
+	couchbaseKVPort      = 11210
+	couchbaseKVTLSPort   = 11207
+	couchbaseKVLocalPort = 11209
+)
+
+// isCouchbaseOnlyOpcode reports an operation memcached does not have: a client
+// negotiating features or a bucket, or using Couchbase's metadata, replica,
+// observe, lock, sub-document or DCP commands. Seeing one marks the connection
+// as Couchbase for every later packet. SASL is not among them: memcached speaks
+// it too (`memcached -S`, used by dalli and spymemcached with credentials), and
+// a Couchbase SDK sends HELLO before it authenticates anyway.
+func isCouchbaseOnlyOpcode(op couchbasekv.Opcode) bool {
+	switch op {
+	case couchbasekv.OpcodeHello, couchbasekv.OpcodeSelectBucket, couchbasekv.OpcodeGetClusterConfig,
+		couchbasekv.OpcodeGetErrorMap, couchbasekv.OpcodeCollectionsGetID,
+		couchbasekv.OpcodeCollectionsGetManifest, couchbasekv.OpcodeCollectionsSetManifest,
+		couchbasekv.OpcodeGetReplica, couchbasekv.OpcodeObserve, couchbasekv.OpcodeObserveSeqno,
+		couchbasekv.OpcodeGetLocked, couchbasekv.OpcodeUnlockKey, couchbasekv.OpcodeGetMeta,
+		couchbasekv.OpcodeGetQMeta, couchbasekv.OpcodeSetWithMeta, couchbasekv.OpcodeSetQWithMeta,
+		couchbasekv.OpcodeAddWithMeta, couchbasekv.OpcodeAddQWithMeta, couchbasekv.OpcodeDelWithMeta,
+		couchbasekv.OpcodeDelQWithMeta:
+		return true
+	}
+	return (op >= couchbasekv.OpcodeDcpOpen && op <= couchbasekv.OpcodeDcpCacheTransferEnd) ||
+		(op >= couchbasekv.OpcodeSubdocGet && op <= couchbasekv.OpcodeSubdocReplaceBodyWithXattr)
+}
+
+// memcachedOutcomeIsNormal reports the binary-protocol statuses that memcached's
+// text protocol reports as NOT_FOUND, EXISTS and NOT_STORED, which the text
+// parser does not treat as errors either.
+func memcachedOutcomeIsNormal(status couchbasekv.Status) bool {
+	switch status {
+	case couchbasekv.StatusKeyNotFound, couchbasekv.StatusKeyExists, couchbasekv.StatusItemNotStored:
+		return true
+	}
+	return false
+}
+
+// markCouchbaseConnection remembers that connInfo spoke a Couchbase-only operation.
+func markCouchbaseConnection(connInfo BpfConnectionInfoT, bucketCache *simplelru.LRU[BpfConnectionInfoT, CouchbaseBucketInfo]) {
+	if bucketCache == nil {
+		return
+	}
+	bucketInfo, _ := bucketCache.Get(connInfo)
+	if bucketInfo.Couchbase {
+		return
+	}
+	bucketInfo.Couchbase = true
+	bucketCache.Add(connInfo, bucketInfo)
+}
+
+// binaryProtocolIsCouchbase tells Couchbase from memcached on the binary protocol
+// they share. A Couchbase client negotiates (HELLO, SASL, SELECT_BUCKET,
+// GET_CLUSTER_CONFIG) before its first KV operation and the KV service listens on
+// 11210 or 11207; a connection with none of that is memcached, whose clients
+// (dalli, pymemcache, spymemcached) send plain GET/SET from the first byte.
+func binaryProtocolIsCouchbase(connInfo BpfConnectionInfoT, bucketInfo CouchbaseBucketInfo) bool {
+	if bucketInfo.Couchbase || bucketInfo.Bucket != "" {
+		return true
+	}
+	for _, port := range []uint16{connInfo.S_port, connInfo.D_port} {
+		if port == couchbaseKVPort || port == couchbaseKVTLSPort || port == couchbaseKVLocalPort {
+			return true
+		}
+	}
+	return false
 }
 
 var errInvalidCouchbase = errors.New("no valid Couchbase request packets found")
