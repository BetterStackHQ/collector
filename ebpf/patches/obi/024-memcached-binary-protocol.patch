 // CouchbaseBucketInfo holds the bucket, scope, and collection for a Couchbase connection.
+// Couchbase records that the connection spoke a Couchbase-only operation (HELLO,
+// SASL, SELECT_BUCKET, GET_CLUSTER_CONFIG, ...), which tells it from memcached:
+// both speak the same binary protocol.
 type CouchbaseBucketInfo struct {
 	Bucket     string
 	Scope      string
 	Collection string
+	Couchbase  bool
 }
 
