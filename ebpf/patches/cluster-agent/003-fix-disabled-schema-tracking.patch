+++ b/metrics/schema_tracking_test.go
@@ -0,0 +1,26 @@
+package metrics
+
+import (
+	"net/url"
+	"testing"
+	"time"
+
+	"github.com/coroot/coroot-cluster-agent/flags"
+	"github.com/coroot/coroot-cluster-agent/metrics/dbtracker"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDisabledSchemaTrackingPassesNilEmitter(t *testing.T) {
+	oldURL, oldInterval, oldTracking := *flags.CorootURL, *flags.MetricsScrapeInterval, *flags.TrackDatabaseChanges
+	t.Cleanup(func() {
+		*flags.CorootURL, *flags.MetricsScrapeInterval, *flags.TrackDatabaseChanges = oldURL, oldInterval, oldTracking
+	})
+	*flags.CorootURL, _ = url.Parse("http://127.0.0.1:38263")
+	*flags.MetricsScrapeInterval = 15 * time.Second
+	*flags.TrackDatabaseChanges = false
+	ms, err := NewMetrics(nil, nil)
+	require.NoError(t, err)
+	// Database constructors use this interface; a typed nil would enable tracking.
+	var changeEmitter dbtracker.ChangeEmitter = ms.changeEmitter
+	require.True(t, changeEmitter == nil)
+}
