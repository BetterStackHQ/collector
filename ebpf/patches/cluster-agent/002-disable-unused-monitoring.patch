diff --git a/metrics/ksm/monitoring_test.go b/metrics/ksm/monitoring_test.go
new file mode 100644
index 0000000..bebbca9
--- /dev/null
+++ b/metrics/ksm/monitoring_test.go
@@ -0,0 +1,18 @@
+package ksm
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v3"
+	crs "k8s.io/kube-state-metrics/v2/pkg/customresourcestate"
+)
+
+func TestCustomResourceWatchersPreserveExistingScope(t *testing.T) {
+	var cfg crs.Metrics
+	require.NoError(t, yaml.Unmarshal([]byte(customResourceConfig()), &cfg))
+	require.Len(t, cfg.Spec.Resources, len(fluxcd()))
+	for i, resource := range cfg.Spec.Resources {
+		require.Equal(t, fluxcd()[i].GroupVersionKind, resource.GroupVersionKind)
+	}
+}
