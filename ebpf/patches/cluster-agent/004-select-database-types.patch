+// An unset selection preserves upstream defaults; an empty selection disables all databases.
+func databaseTypeEnabled(kind TargetType) bool {
+	selected, configured := os.LookupEnv("DATABASE_TYPES")
+	return !configured || slices.Contains(strings.Split(selected, ","), string(kind))
+}
+
 func TargetFromConfig(i config.ApplicationInstrumentation) *Target {
+	if !databaseTypeEnabled(TargetType(i.Type)) {
+		return nil
+	}
 	t := &Target{
 		Type: TargetType(i.Type),
 		Addr: net.JoinHostPort(i.Host, i.Port),
