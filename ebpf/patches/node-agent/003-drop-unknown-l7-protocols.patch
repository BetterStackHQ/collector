diff --git a/containers/l7_test.go b/containers/l7_test.go
new file mode 100644
index 0000000..f3c824e
--- /dev/null
+++ b/containers/l7_test.go
@@ -0,0 +1,52 @@
+package containers
+
+import (
+	"testing"
+	"time"
+
+	"github.com/coroot/coroot-node-agent/common"
+	"github.com/coroot/coroot-node-agent/ebpftracer/l7"
+	"github.com/prometheus/client_golang/prometheus"
+	"inet.af/netaddr"
+)
+
+type l7StatsCollector struct{ L7Stats }
+
+func (c l7StatsCollector) Describe(ch chan<- *prometheus.Desc) {
+	ch <- prometheus.NewDesc("l7_stats", "", nil, nil)
+}
+
+func (c l7StatsCollector) Collect(ch chan<- prometheus.Metric) { c.collect(ch) }
+
+// An L7 event with a protocol id that has no metric definition (e.g. a corrupted
+// event) must not register metrics with an empty name: that breaks every later
+// /metrics scrape with `"" is not a valid metric name`.
+func TestL7StatsIgnoresUnknownProtocols(t *testing.T) {
+	stats := L7Stats{}
+	key := common.NewDestinationKey(netaddr.MustParseIPPort("10.0.0.1:443"), netaddr.MustParseIPPort("10.0.0.1:443"), nil)
+
+	for _, protocol := range []l7.Protocol{0, l7.Protocol(200)} {
+		m := stats.get(protocol, key)
+		if m != nil {
+			t.Fatalf("protocol %d: got metrics, want nil", protocol)
+		}
+		m.observe("200", "", time.Millisecond) // nil-safe
+	}
+	stats.get(l7.ProtocolHTTP, key).observe("200", "", time.Millisecond)
+
+	reg := prometheus.NewRegistry()
+	reg.MustRegister(l7StatsCollector{stats})
+	families, err := reg.Gather()
+	if err != nil {
+		t.Fatalf("gather: %v", err)
+	}
+	names := map[string]bool{}
+	for _, f := range families {
+		names[f.GetName()] = true
+	}
+	for _, want := range []string{"container_http_requests_total", "container_http_requests_duration_seconds_total"} {
+		if !names[want] {
+			t.Errorf("missing %s in %v", want, names)
+		}
+	}
+}
